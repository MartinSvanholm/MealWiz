@using TheMealWorkshop.Shared.Features.GroceryList
@inject IStringLocalizer<GroceryListResource> L
@inject IDrawerStateContainer _drawerStateContainer
@inject IGroceryListStateContainer _groceryListStateContainer
@inject IGroceryCategoriesStateContainer _groceryCategoriesStateContainer

@* The red "Clear" next to "In the basket". Deletes every picked item after the confirm drawer. Styled by the page
   (.grocery-clear). Clearing deletes the tick times, so the trip teaches the section order first (MEA-139). *@
<button type="button" class="grocery-clear" data-testid="clear-basket-button" @onclick="OnClearClick">@L["GroceryList_ClearBasket"]</button>

@code {
    private void OnClearClick()
    {
        var count = _groceryListStateContainer.GroceryList.Items.Count(item => item.IsPicked);
        _drawerStateContainer.OpenConfirmDrawer(L.Plural("GroceryList_ClearConfirmTitle", count),
            L["GroceryList_ClearConfirmMessage"], OnConfirmClear);
    }

    private async Task OnConfirmClear()
    {
        var picked = _groceryListStateContainer.GroceryList.Items.Where(item => item.IsPicked).ToList();
        await _groceryCategoriesStateContainer.LearnFromTicks(picked, basketCleared: true);
        await _groceryListStateContainer.ClearBasket();
        _drawerStateContainer.CloseDrawer();
    }
}
