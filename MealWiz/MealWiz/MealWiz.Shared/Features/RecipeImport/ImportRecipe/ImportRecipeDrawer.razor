@inject IRecipeImportStateContainer _recipeImportStateContainer
@inject IMealsStateContainer _mealsStateContainer
@inject IDrawerStateContainer _drawerStateContainer
@inject NavigationManager _navigationManager
@implements IDisposable

<MudStack Class="pa-3" Style="flex: 1 1 0; min-height: 0; overflow-y: auto;">
    @if (_recipeImportStateContainer.IsImportInProgress || _recipeImportStateContainer.JobStatus == RecipeImportJobStatus.Succeeded)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-4" Spacing="3">
            <MudProgressCircular Indeterminate Color="Color.Primary" />

            @if (_recipeImportStateContainer.IsRunningInBackground)
            {
                <MudText Align="Align.Center">Importing in the background — we'll add it to your meals when it's done.</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="_drawerStateContainer.CloseDrawer">Close</MudButton>
            }
            else
            {
                <MudText Align="Align.Center">Fetching and parsing your recipe…</MudText>

                @if (_recipeImportStateContainer.CanContinueInBackground)
                {
                    <MudText Typo="Typo.body2" Align="Align.Center">
                        This is taking a while. You can keep using the app — we'll add the meal to your list when it's ready.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnContinueInBackgroundClick">Continue in background</MudButton>
                }
            }
        </MudStack>
    }
    else
    {
        @if (_recipeImportStateContainer.JobStatus == RecipeImportJobStatus.Failed)
        {
            <MudAlert Severity="Severity.Error" Dense>@_recipeImportStateContainer.JobErrorMessage</MudAlert>
        }

        <MudTextField @bind-Value="_url"
                      Class="flex-grow-0"
                      Label="Recipe URL"
                      Placeholder="https://"
                      Variant="Variant.Outlined"
                      InputType="InputType.Url"
                      InputMode="InputMode.url"
                      Immediate
                      AutoFocus
                      Error="@(_urlError is not null)"
                      ErrorText="@_urlError"
                      OnKeyDown="OnUrlKeyDown" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth OnClick="StartImport">
            @(_recipeImportStateContainer.JobStatus == RecipeImportJobStatus.Failed ? "Try again" : "Import")
        </MudButton>
    }
</MudStack>

@code {
    private string _url = string.Empty;
    private string? _urlError;
    private bool _isClosing;

    protected override void OnInitialized()
    {
        // Start clean unless a job is still running, or a foreground success hasn't been taken to the form yet
        // (handled after the first render).
        if (!_recipeImportStateContainer.IsImportInProgress && !IsUnclaimedFastSuccess)
            _recipeImportStateContainer.ResetJob();

        _recipeImportStateContainer.OnStateChanged += OnImportStateChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            HandleJobState();
    }

    private bool IsUnclaimedFastSuccess =>
        _recipeImportStateContainer.JobStatus == RecipeImportJobStatus.Succeeded
        && !_recipeImportStateContainer.IsRunningInBackground
        && _recipeImportStateContainer.CurrentImport?.ParsedMeal is not null;

    // Realtime callbacks can arrive off the UI thread (MAUI).
    private void OnImportStateChanged() => InvokeAsync(HandleJobState);

    private void HandleJobState()
    {
        if (_isClosing) return;

        if (IsUnclaimedFastSuccess)
        {
            // Resolved while the drawer was open: review the meal in the existing Save Meal form.
            _isClosing = true;
            _mealsStateContainer.MealToEdit = _recipeImportStateContainer.CurrentImport!.ParsedMeal!.ToMeal();
            _drawerStateContainer.CloseDrawer();
            _navigationManager.NavigateTo("/meals/edit");
            _recipeImportStateContainer.ResetJob();
            return;
        }

        if (_recipeImportStateContainer.IsRunningInBackground && !_recipeImportStateContainer.IsImportInProgress)
        {
            // A backgrounded job resolved while the drawer was reopened; the container already saved/toasted it.
            _isClosing = true;
            _drawerStateContainer.CloseDrawer();
            _recipeImportStateContainer.ResetJob();
            return;
        }

        StateHasChanged();
    }

    private async Task StartImport()
    {
        if (_recipeImportStateContainer.IsImportInProgress) return;

        _urlError = null;

        var result = await _recipeImportStateContainer.StartImport(_url);

        // A failed insert fails the job itself (shown in the alert); anything else is about the input.
        if (result.IsFailed && _recipeImportStateContainer.JobStatus != RecipeImportJobStatus.Failed)
            _urlError = result.Errors.First().Message;
    }

    private async Task OnUrlKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await StartImport();
    }

    private void OnContinueInBackgroundClick()
    {
        _recipeImportStateContainer.ContinueInBackground();
        _drawerStateContainer.CloseDrawer();
    }

    public void Dispose()
    {
        _recipeImportStateContainer.OnStateChanged -= OnImportStateChanged;

        // Closing the drawer while the import runs (X, overlay tap, navigating away) backgrounds it.
        if (_recipeImportStateContainer.IsImportInProgress && !_recipeImportStateContainer.IsRunningInBackground)
            _recipeImportStateContainer.ContinueInBackground();
    }
}
