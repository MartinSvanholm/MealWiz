@attribute [Authorize]
@page "/meals/import"
@inject IRecipeImportStateContainer _recipeImportStateContainer
@inject IDrawerStateContainer _drawerStateContainer
@inject NavigationManager _navigationManager
@implements IDisposable

<MudStack Spacing="0" Style="height: calc(100vh - 56px)">
    <MudPaper Class="rounded-t-0">
        <MudGrid Spacing="0" Class="my-1">
            <MudItem xs="4" Class="d-flex align-center flex-row justify-start pl-1">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="OnBackClick" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="4" Class="d-flex align-center flex-row justify-center">
                <MudText Typo="Typo.h6">Import recipe</MudText>
            </MudItem>
            <MudItem xs="4" />
        </MudGrid>
    </MudPaper>

    <div style="height: calc(100vh - 56px - 48px)" class="overflow-y-auto">
        <MudStack Class="pa-4">
            @switch (_recipeImportStateContainer.EntryState)
            {
                case RecipeImportEntryState.InProgress:
                    <BaseCard Dense CardColor="Color.Info" OnClick="OpenImportDrawer">
                        <Content>
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="3">
                                <MudProgressCircular Indeterminate Size="Size.Small" Color="Color.Info" />
                                <MudStack Spacing="0" Style="min-width: 0;">
                                    <MudText Typo="Typo.subtitle1">Import in progress…</MudText>
                                    <MudText Typo="Typo.body2" Class="text-truncate">@_recipeImportStateContainer.CurrentImport?.SourceUrl</MudText>
                                </MudStack>
                            </MudStack>
                        </Content>
                    </BaseCard>
                    break;

                case RecipeImportEntryState.Failed:
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                        <MudText Typo="Typo.subtitle1">Your last import failed</MudText>
                        <MudText Typo="Typo.body2">@_recipeImportStateContainer.LatestErrorMessage</MudText>
                        @if (!string.IsNullOrEmpty(_recipeImportStateContainer.LatestImport?.SourceUrl))
                        {
                            <MudText Typo="Typo.caption" Style="word-break: break-all;">@_recipeImportStateContainer.LatestImport.SourceUrl</MudText>
                        }
                    </MudAlert>
                    @EntryPoint
                    break;

                default:
                    @EntryPoint
                    break;
            }
        </MudStack>
    </div>
</MudStack>

@code {
    private RenderFragment EntryPoint => @<BaseCard Dense CardColor="Color.Secondary" OnClick="OpenImportDrawer">
        <Content>
            <MudStack Row AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.Link" Color="Color.Secondary" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1">Paste a recipe URL</MudText>
                    <MudText Typo="Typo.body2">We'll fetch the recipe and fill in the meal for you.</MudText>
                </MudStack>
            </MudStack>
        </Content>
    </BaseCard>;

    protected override async Task OnInitializedAsync()
    {
        _recipeImportStateContainer.OnStateChanged += OnImportStateChanged;

        await _recipeImportStateContainer.LoadLatestImport();
    }

    // Realtime callbacks can arrive off the UI thread (MAUI).
    private void OnImportStateChanged() => InvokeAsync(StateHasChanged);

    private void OpenImportDrawer()
    {
        _drawerStateContainer.OpenDrawer(new DrawerStateParameters
        {
            Content = typeof(ImportRecipeDrawer),
            Title = "Import recipe",
            Height = "45%"
        });
    }

    private void OnBackClick()
    {
        _navigationManager.NavigateTo("/meals");
    }

    public void Dispose()
    {
        _drawerStateContainer.CloseDrawer();
        _recipeImportStateContainer.OnStateChanged -= OnImportStateChanged;
    }
}
