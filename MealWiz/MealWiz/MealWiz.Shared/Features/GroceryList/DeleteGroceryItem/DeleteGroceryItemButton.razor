@inject IDrawerStateContainer _drawerStateContainer
@inject IGroceryListStateContainer _groceryListStateContainer

@* The red delete action in the Edit item drawer's header. Deletes after the confirm drawer. *@
<MudIconButton data-testid="delete-grocery-item-button" aria-label="Delete" OnClick="OnDeleteClick" Icon="@Icons.Material.Outlined.Delete" Class="mw-text-red" />

@code {
    [Parameter]
    public GroceryItem GroceryItem { get; set; } = new();

    private void OnDeleteClick()
    {
        _drawerStateContainer.OpenConfirmDrawer($"Delete {GroceryItem.Name}?", "Are you sure you want to delete this grocery item?", OnConfirmDelete);
    }

    private async Task OnConfirmDelete()
    {
        await _groceryListStateContainer.DeleteGroceryItem(GroceryItem);
        _drawerStateContainer.CloseDrawer();
    }
}
