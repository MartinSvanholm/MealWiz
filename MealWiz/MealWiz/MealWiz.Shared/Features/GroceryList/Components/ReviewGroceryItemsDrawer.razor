@inject IGroceryListStateContainer _groceryListStateContainer
@inject IDrawerStateContainer _drawerStateContainer
@inject ISnackbar _snackbar

@* Items from meals no longer in the plan, one section per old meal and every item ticked. Remove deletes the ticked
   items; the unticked ones stay and become the user's own items (unlinked). Opened from Groceries, and meant to be
   reused wherever a meal's grocery items need a decision. *@
@if (Groups.Sum(g => g.Items.Count) == 0)
{
    <div class="review-items-empty" data-testid="review-items-empty">Nothing to review</div>
}
else
{
    <p class="review-items-hint" data-testid="review-items-hint">Ticked items are removed from your list. Unticked items stay as your own items.</p>

    @foreach (var group in Groups)
    {
        <section class="review-group" data-testid="review-group">
            <h3 class="review-group-heading" data-testid="review-group-heading">@group.Heading</h3>
            <ul class="review-items">
                @foreach (var item in group.Items)
                {
                    var ticked = _ticked.Contains(item.Id);
                    <li data-testid="review-item" @key="item.Id">
                        <button type="button" class="review-item" data-testid="review-item-checkbox"
                                role="checkbox" aria-checked="@(ticked ? "true" : "false")" aria-label="@($"Remove {item.Name}")"
                                @onclick="() => Toggle(item.Id)">
                            <span class="review-item-box @(ticked ? "is-ticked" : "")" aria-hidden="true">
                                @if (ticked)
                                {
                                    <MudIcon Icon="@Icons.Material.Rounded.Check" Class="review-item-check" />
                                }
                            </span>
                            <span class="review-item-name" data-testid="review-item-name">@item.Name</span>
                            @if (!string.IsNullOrWhiteSpace(item.Amount))
                            {
                                <span class="review-item-amount" data-testid="review-item-amount">@item.Amount</span>
                            }
                        </button>
                    </li>
                }
            </ul>
        </section>
    }

    <DrawerFooter>
        <MudButton data-testid="review-items-confirm" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                   Disabled="_removing" OnClick="OnConfirm">
            @ConfirmLabel
        </MudButton>
    </DrawerFooter>
}

@code {
    /// <summary>The items to review, grouped by their old meal.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<GroceryItemGroup> Groups { get; set; } = [];

    /// <summary>Runs after a successful Remove or Keep all, once the drawer is closed.</summary>
    [Parameter] public Func<Task>? AfterRemove { get; set; }

    /// <summary>Opens the drawer for <paramref name="groups"/>; <paramref name="afterRemove"/> runs after a successful clean-up.</summary>
    public static void Open(IDrawerStateContainer drawer, string title, IReadOnlyList<GroceryItemGroup> groups, Func<Task>? afterRemove = null)
    {
        var parameters = new Dictionary<string, object> { [nameof(Groups)] = groups };
        if (afterRemove is not null) parameters[nameof(AfterRemove)] = afterRemove;

        drawer.OpenDrawer(new DrawerStateParameters
        {
            Content = typeof(ReviewGroceryItemsDrawer),
            Title = title,
            Width = "100%",
            Height = "calc(100% - 64px)",
            ContentParameters = parameters
        });
    }

    private readonly HashSet<int> _ticked = [];
    private bool _removing;

    private IEnumerable<GroceryItem> AllItems => Groups.SelectMany(g => g.Items);

    private string ConfirmLabel => _ticked.Count switch
    {
        0 => "Keep all",
        1 => "Remove 1 item",
        var n => $"Remove {n} items"
    };

    protected override void OnInitialized()
    {
        foreach (var item in AllItems) _ticked.Add(item.Id);
    }

    private void Toggle(int id)
    {
        if (!_ticked.Remove(id)) _ticked.Add(id);
    }

    private async Task OnConfirm()
    {
        if (_removing) return;

        _removing = true;
        _groceryListStateContainer.CurrentSnackbar = _snackbar;

        var all = AllItems.Select(i => i.Id).ToList();
        var deleteIds = all.Where(_ticked.Contains).ToList();
        var unlinkIds = all.Where(id => !_ticked.Contains(id)).ToList();

        var ok = await _groceryListStateContainer.DeleteAndUnlinkGroceryItems(deleteIds, unlinkIds);
        _removing = false;
        if (!ok) return;

        _drawerStateContainer.CloseDrawer();
        _snackbar.Add(deleteIds.Count > 0
            ? $"Removed {deleteIds.Count} {(deleteIds.Count == 1 ? "item" : "items")}"
            : $"Kept {unlinkIds.Count} {(unlinkIds.Count == 1 ? "item" : "items")}", Severity.Success);

        if (AfterRemove is not null) await AfterRemove();
    }
}
