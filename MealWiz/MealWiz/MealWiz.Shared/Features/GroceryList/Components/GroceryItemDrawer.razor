@* Add or edit a grocery item: name and amount side by side, then "Save item". When the name is already filled in
   (from the add field), the amount gets the focus. *@
<div class="grocery-item-fields">
    <div class="mw-field">
        <label class="mw-field-label" for="grocery-item-name">Name</label>
        <MudTextField @ref="_nameField" data-testid="grocery-item-name-input" InputId="grocery-item-name" @bind-Value="GroceryItem.Name" Variant="Variant.Outlined"
                      OnKeyDown="EnterKey.Then(() => _amountField.FocusAsync())" />
    </div>
    <div class="mw-field">
        <label class="mw-field-label" for="grocery-item-amount">Amount</label>
        <MudTextField @ref="_amountField" data-testid="grocery-item-amount-input" InputId="grocery-item-amount" Placeholder="e.g. 2" @bind-Value="GroceryItem.Amount" Variant="Variant.Outlined"
                      Immediate OnKeyDown="EnterKey.Then(() => _saveButton.SaveClicked())" />
    </div>
</div>
<DrawerFooter>
    <SaveGroceryItemButton @ref="_saveButton" GroceryItem="GroceryItem" />
</DrawerFooter>

@code {
    /// <summary>Fits the header, the labelled fields and "Save item". The sheet body flexes from 0, so "auto" would collapse it.</summary>
    public const string DrawerHeight = "calc(272px + env(safe-area-inset-bottom))";

    [Parameter]
    public GroceryItem GroceryItem { get; set; } = new();

    private MudTextField<string> _nameField = default!;
    private MudTextField<string> _amountField = default!;
    private SaveGroceryItemButton _saveButton = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (string.IsNullOrWhiteSpace(GroceryItem.Name))
            await _nameField.FocusAsync();
        else
            await _amountField.FocusAsync();
    }
}
