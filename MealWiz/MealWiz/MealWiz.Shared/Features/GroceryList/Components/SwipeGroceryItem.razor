@using System.Globalization
@using MealWiz.Shared.Features.GroceryList
@using MealWiz.Shared.Features.GroceryList.DeleteGroceryItem
@implements IHandleEvent
@inject IStringLocalizer<GroceryListResource> L
@inject IDrawerStateContainer _drawerStateContainer
@inject IGroceryListStateContainer _groceryListStateContainer
@inject IGroceryCategoriesStateContainer _groceryCategoriesStateContainer

@* A to-buy row that can be swiped either way: the row follows the pointer over a coloured layer. Letting go past
   SwipeDistance to the left opens the same confirm drawer as the edit drawer's delete; to the right it opens Move, the
   category chips for the item's name (only once the categories have loaded). Plain pointer events, so touch and mouse
   both work; touch-action: pan-y leaves vertical scrolling to the browser. *@
<div class="grocery-swipe">
    @* Always there, so they stay visible while the row snaps back; the row's surface covers them at rest. Each covers
       the half of the row a swipe uncovers. *@
    <div class="grocery-swipe-move" data-testid="grocery-item-swipe-move" aria-hidden="true">
        <MudIcon Icon="@Icons.Material.Outlined.Category" Class="grocery-swipe-icon" />
    </div>
    <div class="grocery-swipe-delete" data-testid="grocery-item-swipe-delete" aria-hidden="true">
        <MudIcon Icon="@Icons.Material.Outlined.Delete" Class="grocery-swipe-icon" />
    </div>
    <div class="grocery-swipe-row @(_direction != 0 ? "swiping" : null)" data-testid="grocery-item-swipe" style="@RowStyle"
         @onpointerdown="OnPointerDown" @onpointermove="OnPointerMove" @onpointerup="OnPointerUp"
         @onpointerleave="OnPointerUp" @onpointercancel="OnPointerCancel">
        @ChildContent
    </div>
</div>

@code {
    /// <summary>How far (px) the row must be dragged, left to delete or right to move, for letting go to act.</summary>
    public const double SwipeDistance = 80;

    // Movement under this is still a tap on the checkbox or name.
    private const double Slop = 10;

    [Parameter]
    public GroceryItem GroceryItem { get; set; } = new();

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private long? _pointerId;
    private double _startX;
    private double _startY;
    // -1 while swiping left (delete), 1 while swiping right (move), 0 when not swiping.
    private int _direction;
    private double _offset;

    private string? RowStyle => _offset != 0
        ? $"transform: translateX({Math.Round(_offset).ToString(CultureInfo.InvariantCulture)}px)"
        : null;

    // Moving needs the categories; if they failed to load there's nothing to move to.
    private bool CanMove => _groceryCategoriesStateContainer.Categories.Count > 0;

    // Pointer events fire on every hover, so only re-render when the swipe actually changes.
    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? arg) => callback.InvokeAsync(arg);

    private void OnPointerDown(PointerEventArgs e)
    {
        if (_pointerId is not null || (e.PointerType == "mouse" && e.Button != 0))
            return;

        _pointerId = e.PointerId;
        _startX = e.ClientX;
        _startY = e.ClientY;
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (_pointerId != e.PointerId)
            return;

        var dx = e.ClientX - _startX;
        var dy = e.ClientY - _startY;
        if (_direction == 0)
        {
            if (Math.Abs(dx) < Slop && Math.Abs(dy) < Slop)
                return;

            // Up or down, or right without categories: not a swipe, so let the page have it.
            if (Math.Abs(dy) >= Math.Abs(dx) || (dx > 0 && !CanMove))
            {
                _pointerId = null;
                return;
            }

            _direction = dx < 0 ? -1 : 1;
        }

        // The row stays on the side it started to: a swipe left that turns back stops at rest.
        _offset = _direction < 0 ? Math.Min(0, dx) : Math.Max(0, dx);
        StateHasChanged();
    }

    private void OnPointerUp(PointerEventArgs e)
    {
        if (_pointerId != e.PointerId)
            return;

        var delete = _offset <= -SwipeDistance;
        var move = _offset >= SwipeDistance;
        Reset();
        if (delete)
            ConfirmDeleteGroceryItem.Open(_drawerStateContainer, _groceryListStateContainer, L, GroceryItem);
        else if (move)
            MoveGroceryItemDrawer.Open(_drawerStateContainer, L["MoveItem_Title", GroceryItem.Name], GroceryItem);
    }

    private void OnPointerCancel(PointerEventArgs e)
    {
        if (_pointerId == e.PointerId)
            Reset();
    }

    // The row snaps back; after a delete swipe it stays visible behind the confirm drawer, so cancelling keeps it.
    private void Reset()
    {
        var changed = _direction != 0;
        _pointerId = null;
        _direction = 0;
        _offset = 0;
        if (changed)
            StateHasChanged();
    }
}
