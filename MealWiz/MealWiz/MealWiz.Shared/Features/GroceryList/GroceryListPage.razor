@page "/grocerylist"
@attribute [Authorize]
@inject ISnackbar _snackbar
@inject IDrawerStateContainer _drawerStateContainer
@inject IGroceryListStateContainer _groceryListStateContainer
@inject IMealPlanStateContainer _mealPlanStateContainer
@implements IDisposable

@* Dense on purpose: the shopper needs to see everything left to find, so about ten to-buy rows fit on a phone. *@
<div class="mw-page grocery-page">
    <ScreenHeader Label="@HeaderLabel" Title="Groceries">
        <Actions>
            <AddIngredientsToGroceryListButton />
        </Actions>
    </ScreenHeader>

    <div class="grocery-top">
        <div class="grocery-progress-row">
            <div class="grocery-progress" data-testid="grocery-progress" role="progressbar"
                 aria-label="Items in the basket" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@ProgressPercent">
                <div class="grocery-progress-fill" style="width: @(ProgressPercent)%"></div>
            </div>
            <span class="grocery-progress-count" data-testid="grocery-progress-count"><span class="grocery-progress-picked">@Picked.Count</span> of @Items.Count @ItemsWord</span>
        </div>

        <AddGroceryItemField />
    </div>

    <div class="grocery-scroll">
        @if (Items.Count == 0)
        {
            <div class="grocery-empty" data-testid="grocery-list-empty">
                <span class="grocery-empty-title">Your list is empty</span>
                <span>Add an item above, or take the week's ingredients from your meal plan.</span>
            </div>
        }

        @if (ToBuy.Count > 0)
        {
            <section class="grocery-section">
                <h2 class="grocery-section-heading" data-testid="grocery-to-buy-heading">To buy · @ToBuy.Count</h2>
                <ul class="grocery-to-buy" data-testid="grocery-to-buy">
                    @foreach (var item in ToBuy)
                    {
                        <li class="grocery-row" data-testid="grocery-item" @key="item">
                            <button type="button" class="grocery-check" data-testid="grocery-item-checkbox"
                                    role="checkbox" aria-checked="false" aria-label="@($"Check off {item.Name}")"
                                    @onclick="() => _groceryListStateContainer.ToggleIsPicked(item)">
                                <span class="grocery-check-box" aria-hidden="true"></span>
                            </button>
                            <EditGroceryItemButton GroceryItem="item" />
                            @if (!string.IsNullOrWhiteSpace(item.Amount))
                            {
                                <span class="grocery-amount" data-testid="grocery-item-amount">@item.Amount</span>
                            }
                        </li>
                    }
                </ul>
            </section>
        }

        @if (Picked.Count > 0)
        {
            <section class="grocery-section">
                <div class="grocery-section-row">
                    <h2 class="grocery-section-heading" data-testid="grocery-basket-heading">In the basket · @Picked.Count</h2>
                    @* Not wired yet: nothing clears the basket in bulk (MEA-73). *@
                    <button type="button" class="grocery-clear" data-testid="clear-basket-button">Clear</button>
                </div>
                <ul class="grocery-basket" data-testid="grocery-basket">
                    @foreach (var item in Picked)
                    {
                        <li data-testid="grocery-item" @key="item">
                            <button type="button" class="grocery-pill" data-testid="grocery-item-checkbox"
                                    role="checkbox" aria-checked="true" aria-label="@($"Put {item.Name} back on the list")"
                                    @onclick="() => _groceryListStateContainer.ToggleIsPicked(item)">
                                <MudIcon Icon="@Icons.Material.Rounded.Check" Class="grocery-pill-check" />
                                <span class="grocery-pill-name">@item.Name</span>
                            </button>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>
</div>

@code {
    private List<GroceryItem> Items => _groceryListStateContainer.GroceryList.Items;
    private List<GroceryItem> ToBuy => Items.Where(i => !i.IsPicked).ToList();
    private List<GroceryItem> Picked => Items.Where(i => i.IsPicked).ToList();

    private string ItemsWord => Items.Count == 1 ? "item" : "items";

    private int ProgressPercent => Items.Count == 0 ? 0 : (int)Math.Round(100.0 * Picked.Count / Items.Count);

    // The week the "From meal plan" drawer takes its ingredients from.
    private string HeaderLabel =>
        $"{Items.Count} {ItemsWord} · Week {System.Globalization.ISOWeek.GetWeekOfYear(_mealPlanStateContainer.SelectedWeekStart)}";

    protected override async Task OnInitializedAsync()
    {
        _groceryListStateContainer.OnStateChanged += StateHasChanged;
        _groceryListStateContainer.CurrentSnackbar = _snackbar;
        await _groceryListStateContainer.LoadGroceryItems();

        await base.OnInitializedAsync();
    }

    public void Dispose()
    {
        _groceryListStateContainer.OnStateChanged -= StateHasChanged;
        _drawerStateContainer.CloseDrawer();
    }
}
