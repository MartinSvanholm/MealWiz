@page "/grocerylist"
@attribute [Authorize]
@using MealWiz.Shared.Features.GroceryList.ClearBasket
@inject IStringLocalizer<GroceryListResource> L
@inject ISnackbar _snackbar
@inject IDrawerStateContainer _drawerStateContainer
@inject IGroceryListStateContainer _groceryListStateContainer
@inject IMealPlanStateContainer _mealPlanStateContainer
@inject IGroceryCategoriesStateContainer _groceryCategoriesStateContainer
@inject IStringLocalizer<GroceryCategoriesResource> C
@implements IDisposable

@* Dense on purpose: the shopper needs to see everything left to find, so about ten to-buy rows fit on a phone. *@
<div class="mw-page grocery-page">
    <ScreenHeader Label="@HeaderLabel" Title="@L["GroceryList_Title"]">
        <Actions>
            <AddIngredientsToGroceryListButton />
            <a class="grocery-categories-button" href="grocerylist/categories" data-testid="grocery-categories-button"
               aria-label="@L["GroceryList_CategoriesAria"]">
                <MudIcon Icon="@Icons.Material.Outlined.Category" Size="Size.Small" />
            </a>
        </Actions>
    </ScreenHeader>

    <div class="grocery-top">
        <div class="grocery-progress-row">
            <div class="grocery-progress" data-testid="grocery-progress" role="progressbar"
                 aria-label="@L["GroceryList_ProgressAria"]" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@ProgressPercent">
                <div class="grocery-progress-fill" style="width: @(ProgressPercent)%"></div>
            </div>
            <span class="grocery-progress-count" data-testid="grocery-progress-count">@ProgressText</span>
        </div>

        <AddGroceryItemField />
    </div>

    <div class="grocery-scroll">
        @if (StaleCount > 0)
        {
            <section class="grocery-stale" role="status" data-testid="stale-items-banner">
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Class="grocery-stale-icon" />
                <span class="grocery-stale-text" data-testid="stale-items-text">@StaleText</span>
                <button type="button" class="grocery-stale-review" data-testid="stale-items-review" @onclick="OpenReview">@L["StaleBanner_Review"]</button>
            </section>
        }

        @if (Items.Count == 0)
        {
            <div class="grocery-empty" data-testid="grocery-list-empty">
                <span class="grocery-empty-title">@L["GroceryList_Empty"]</span>
                <span>@L["GroceryList_EmptyHint"]</span>
            </div>
        }

        @if (ToBuy.Count > 0 && _categoriesSettled)
        {
            @* One section per category with something to buy, in the user's order. Without categories (the load
               failed) the items are one list without headings. *@
            <div class="grocery-categories" data-testid="grocery-to-buy">
                @if (_groceryCategoriesStateContainer.Categories.Count == 0)
                {
                    <ul class="grocery-rows">
                        @foreach (var item in ToBuy)
                        {
                            @Row(item)
                        }
                    </ul>
                }
                else
                {
                    @foreach (var (category, items) in Sections)
                    {
                        var folded = _groceryCategoriesStateContainer.IsFolded(category.Id);
                        @* Tapping the heading folds the section: the heading and count stay, the rows go. *@
                        <section class="grocery-section" data-testid="grocery-category" data-category="@category.DataKey"
                                 data-folded="@(folded ? "true" : "false")" @key="category.Id">
                            <div class="grocery-section-row">
                                <h2 class="grocery-section-heading">
                                    <button type="button" class="grocery-category-heading" data-testid="grocery-category-heading"
                                            aria-expanded="@(folded ? "false" : "true")"
                                            @onclick="() => _groceryCategoriesStateContainer.ToggleFolded(category.Id)">
                                        <MudIcon Icon="@Icons.Material.Rounded.ExpandMore" Class="@(folded ? "grocery-category-chevron is-folded" : "grocery-category-chevron")" />
                                        <span class="grocery-category-name" data-testid="grocery-category-name">@category.DisplayName(C)</span>
                                        <span aria-hidden="true">·</span>
                                        <span data-testid="grocery-category-count">@items.Count</span>
                                    </button>
                                </h2>
                                @if (category.IsOther)
                                {
                                    <button type="button" class="grocery-sort-button" data-testid="grocery-sort-other"
                                            aria-label="@L["GroceryList_SortAria", category.DisplayName(C)]" @onclick="() => OpenSort(items)">
                                        @L["GroceryList_Sort"]
                                    </button>
                                }
                            </div>
                            @if (!folded)
                            {
                                <ul class="grocery-rows">
                                    @foreach (var item in items)
                                    {
                                        @Row(item)
                                    }
                                </ul>
                            }
                        </section>
                    }
                }
            </div>
        }

        @if (Picked.Count > 0)
        {
            <section class="grocery-section">
                <div class="grocery-section-row">
                    <h2 class="grocery-section-heading" data-testid="grocery-basket-heading">@L["GroceryList_InBasket", Picked.Count]</h2>
                    <ClearBasketButton />
                </div>
                <ul class="grocery-basket" data-testid="grocery-basket">
                    @foreach (var item in Picked)
                    {
                        <li data-testid="grocery-item" @key="item">
                            <button type="button" class="grocery-pill" data-testid="grocery-item-checkbox"
                                    role="checkbox" aria-checked="true" aria-label="@L["GroceryList_PutBackAria", item.Name]"
                                    @onclick="() => _groceryListStateContainer.ToggleIsPicked(item)">
                                <MudIcon Icon="@Icons.Material.Rounded.Check" Class="grocery-pill-check" />
                                <span class="grocery-pill-name">@item.Name</span>
                            </button>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>
</div>

@code {
    private List<GroceryItem> Items => _groceryListStateContainer.GroceryList.Items;
    private List<GroceryItem> ToBuy => Items.Where(i => !i.IsPicked).ToList();
    private List<GroceryItem> Picked => Items.Where(i => i.IsPicked).ToList();

    // Set once the categories have loaded or failed to, so the list doesn't render ungrouped first and then jump.
    private bool _categoriesSettled;

    // Each to-buy item in its category; categories with nothing to buy are left out. Items keep their order.
    private List<(GroceryCategory Category, List<GroceryItem> Items)> Sections
    {
        get
        {
            var categories = _groceryCategoriesStateContainer.Categories;
            var byCategory = ToBuy
                .GroupBy(i => _groceryCategoriesStateContainer.CategoryFor(i.Name)?.Id ?? categories[^1].Id)
                .ToDictionary(g => g.Key, g => g.ToList());

            return categories
                .Where(c => byCategory.ContainsKey(c.Id))
                .Select(c => (c, byCategory[c.Id]))
                .ToList();
        }
    }

    private RenderFragment Row(GroceryItem item) =>
        @<li class="grocery-row" data-testid="grocery-item" @key="item">
            <SwipeToDeleteGroceryItem GroceryItem="item">
                <button type="button" class="grocery-check" data-testid="grocery-item-checkbox"
                        role="checkbox" aria-checked="false" aria-label="@L["GroceryList_CheckOffAria", item.Name]"
                        @onclick="() => _groceryListStateContainer.ToggleIsPicked(item)">
                    <span class="grocery-check-box" aria-hidden="true"></span>
                </button>
                <EditGroceryItemButton GroceryItem="item" />
                @if (!string.IsNullOrWhiteSpace(item.Amount))
                {
                    <span class="grocery-amount" data-testid="grocery-item-amount">@item.Amount</span>
                }
            </SwipeToDeleteGroceryItem>
        </li>;

    private int ProgressPercent => Items.Count == 0 ? 0 : (int)Math.Round(100.0 * Picked.Count / Items.Count);

    // The week the "From meal plan" drawer takes its ingredients from.
    private string HeaderLabel =>
        L[Items.Count == 1 ? "GroceryList_Header_One" : "GroceryList_Header_Other",
            Items.Count, System.Globalization.ISOWeek.GetWeekOfYear(_mealPlanStateContainer.SelectedWeekStart)];

    // "1 of 2 items": the picked count keeps its own span (bold), the noun follows the total. Only numbers are
    // formatted into the markup.
    private MarkupString ProgressText =>
        new(L[Items.Count == 1 ? "GroceryList_Progress_One" : "GroceryList_Progress_Other",
            $"<span class=\"grocery-progress-picked\">{Picked.Count}</span>", Items.Count]);

    // Items from meals no longer in the plan (swapped, or removed from the plan with the switch off).
    private int StaleCount => _groceryListStateContainer.StaleItems.Count;

    private string StaleText => L.Plural("StaleBanner_Text", StaleCount);

    // Sort: the Other items one at a time, as they are listed now.
    private void OpenSort(List<GroceryItem> otherItems) =>
        SortOtherItemsDrawer.Open(_drawerStateContainer, L["SortItems_Title"], otherItems.ToList());

    private void OpenReview() =>
        ReviewGroceryItemsDrawer.Open(
            _drawerStateContainer,
            L["ReviewItems_Title"],
            StaleGroceryItems.GroupByMeal(_groceryListStateContainer.StaleItems, _groceryListStateContainer.Sources));

    protected override async Task OnInitializedAsync()
    {
        _groceryListStateContainer.OnStateChanged += StateHasChanged;
        _groceryCategoriesStateContainer.OnStateChanged += StateHasChanged;
        _groceryListStateContainer.CurrentSnackbar = _snackbar;
        _groceryCategoriesStateContainer.CurrentSnackbar = _snackbar;
        await Task.WhenAll(_groceryListStateContainer.LoadGroceryItems(), LoadCategories(), _groceryCategoriesStateContainer.LoadFolded());
        // A shopping trip that ended (two hours after its last tick) teaches the section order (MEA-139).
        await _groceryCategoriesStateContainer.LearnFromTicks(Picked, basketCleared: false);
        await _groceryListStateContainer.LoadSources();

        await base.OnInitializedAsync();
    }

    private async Task LoadCategories()
    {
        await _groceryCategoriesStateContainer.LoadCategories();
        _categoriesSettled = true;
    }

    public void Dispose()
    {
        _groceryListStateContainer.OnStateChanged -= StateHasChanged;
        _groceryCategoriesStateContainer.OnStateChanged -= StateHasChanged;
        _drawerStateContainer.CloseDrawer();
    }
}
