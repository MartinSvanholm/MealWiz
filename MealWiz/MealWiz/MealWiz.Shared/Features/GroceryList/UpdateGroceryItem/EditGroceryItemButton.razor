@inject IDrawerStateContainer _drawerStateContainer

@* An item's name on the list. Tapping it opens the Edit item drawer, whose red header action deletes the item. *@
<button type="button" class="grocery-item-name" data-testid="grocery-item-name" aria-label="@($"Edit {GroceryItem.Name}")" @onclick="UpdateItemClicked"><span class="grocery-item-name-text">@GroceryItem.Name</span></button>

@code {
    [Parameter]
    public GroceryItem GroceryItem { get; set; } = new();

    public void UpdateItemClicked()
    {
        var item = GroceryItem;
        _drawerStateContainer.OpenDrawer(new DrawerStateParameters
        {
            Content = typeof(GroceryItemDrawer),
            Title = "Edit item",
            Height = DrawerStateParameters.FormHeight,
            HeaderAction = @<DeleteGroceryItemButton GroceryItem="item" />,
            ContentParameters = new Dictionary<string, object>
                {{ nameof(GroceryItemDrawer.GroceryItem), item }}
        });
    }
}
