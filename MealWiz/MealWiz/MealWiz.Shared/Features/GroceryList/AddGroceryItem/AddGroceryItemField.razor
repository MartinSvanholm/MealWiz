@inject IDrawerStateContainer _drawerStateContainer

@* The 44px "Add an item" field and orange + button. + or Enter opens the Add item drawer with the typed name filled
   in, so the amount can be added before saving. *@
<div class="grocery-add">
    <label for="add-grocery-item-input" class="grocery-add-label">Add an item</label>
    <input id="add-grocery-item-input" class="grocery-add-input" data-testid="add-grocery-item-input"
           placeholder="Add an item" autocomplete="off" enterkeyhint="next"
           value="@_name" @oninput="e => _name = e.Value?.ToString() ?? string.Empty" @onkeydown="OnKeyDown" />
    <button type="button" class="grocery-add-button" data-testid="add-grocery-item-button" aria-label="Add item" @onclick="AddItemClicked">
        <MudIcon Icon="@Icons.Material.Rounded.Add" />
    </button>
</div>

@code {
    private string _name = string.Empty;

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddItemClicked();
    }

    public void AddItemClicked()
    {
        var item = new GroceryItem { Name = _name.Trim() };
        _name = string.Empty;

        _drawerStateContainer.OpenDrawer(new DrawerStateParameters
        {
            Content = typeof(GroceryItemDrawer),
            Title = "Add item",
            Height = DrawerStateParameters.FormHeight,
            ContentParameters = new Dictionary<string, object>
                {{ nameof(GroceryItemDrawer.GroceryItem), item }}
        });
    }
}
