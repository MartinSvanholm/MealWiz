@inject ISnackbar _snackbar
@inject IMediator _mediator
@inject IMealPlanStateContainer _mealPlanStateContainer
@inject IStringLocalizer<MealPlansResource> L

@* A 44px dark round button; the Meal plan puts it in the corner of the selected day's orange card. *@
<button type="button" class="mw-remove-meal" data-testid="remove-meal-button" aria-label="@L["RemoveMeal_Aria"]" @onclick="RemoveMealFromMealPlan">
    <MudIcon Icon="@Icons.Material.Rounded.Close" Size="Size.Small" />
</button>

@code {
    private async Task RemoveMealFromMealPlan()
    {
        var meal = _mealPlanStateContainer.GetMealFromSelectedDate();

        if (meal == null || meal.MealDate == null) 
        {
            _snackbar.Add(L["RemoveMeal_MealOrDateMissing"], Severity.Error);
            return;
        }

        var result = await _mediator.Send(new RemoveMealFromMealPlan.Command(meal.Id, _mealPlanStateContainer.MealPlan.Id, meal.MealDate.Value));
        if (result.Handle(_snackbar).IsFailed) return;

        _mealPlanStateContainer.MealPlan.MealOnDate.Remove(meal.MealDate.Value);
        _mealPlanStateContainer.MealPlan.PlannedMealIdOnDate.Remove(meal.MealDate.Value);
        _mealPlanStateContainer.NotifyStateChanged();
    }
}
