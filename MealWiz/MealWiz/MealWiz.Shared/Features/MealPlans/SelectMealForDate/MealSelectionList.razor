@inject IMealPlanStateContainer _mealPlanStateContainer
@inject IMealsStateContainer _mealsStateContainer
@inject ISnackbar _snackbar
@inject NavigationManager _navigationManager
@implements IDisposable

@* The pick-a-meal state of the Meal plan, for a day with no meal: search, shuffle, and one compact list with Eat Out
   and Leftovers first. Each row (meal-list-item) holds the pick button (meal-selection-pick) and, for the user's own
   meals, an edit button (meal-selection-edit). While swapping (IsSwappingMeal) it replaces the day's meal instead:
   the day's meal is left out of the list and Cancel (meal-selection-cancel) goes back to the card. *@
<section class="mw-pick">
    <div class="mw-pick-top">
        <div class="mw-pick-heading">
            @if (CurrentMeal is { } current)
            {
                <h2 class="mw-pick-title" data-testid="meal-selection-heading">Swap the meal for @Day</h2>
                <span class="mw-pick-hint" data-testid="meal-selection-hint">Tap a meal to replace @current.Name.</span>
            }
            else
            {
                <h2 class="mw-pick-title" data-testid="meal-selection-heading">Pick a meal for @Day</h2>
                <span class="mw-pick-hint" data-testid="meal-selection-hint">Nothing planned yet. Tap a meal to add it.</span>
            }
        </div>
        @if (CurrentMeal is not null)
        {
            <button type="button" class="mw-pick-cancel" data-testid="meal-selection-cancel"
                    @onclick="_mealPlanStateContainer.CancelSwap">Cancel</button>
        }
    </div>

    <div class="mw-pick-search">
        <MudTextField T="string" data-testid="meal-selection-search"
                      @bind-Value="_search"
                      Placeholder="Search meals"
                      aria-label="Search meals"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Clearable="true"
                      Class="mw-pick-search-field" />
        <button type="button" class="mw-pick-shuffle" data-testid="shuffle-meals-button" aria-label="Shuffle meals"
                disabled="@_isShuffling" @onclick="ShuffleAsync">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5"></path>
            </svg>
        </button>
    </div>

    @if (_shuffled.Count == 0)
    {
        <p class="mw-pick-empty" data-testid="meal-list-empty">You have no meals yet. Create one from the Meals page.</p>
    }
    else if (!FilteredMeals.Any())
    {
        <p class="mw-pick-no-match" data-testid="meal-list-no-match">No meals match "@_search".</p>
    }
    else
    {
        <ul class="mw-pick-list">
            @foreach (var (meal, index) in FilteredMeals)
            {
                <li class="mw-pick-row" data-testid="meal-list-item">
                    <button type="button" class="mw-pick-button" data-testid="meal-selection-pick" @onclick="() => AssignMeal(meal)">
                        <MealTile Name="@meal.Name" Neutral="@(!meal.IsRegular)" Index="index" />
                        <span class="mw-pick-name" data-testid="meal-selection-name">@meal.Name</span>
                    </button>
                    @if (meal.IsRegular)
                    {
                        <button type="button" class="mw-pick-edit" data-testid="meal-selection-edit"
                                aria-label="@($"Edit {meal.Name}")" @onclick="() => EditMeal(meal)">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M4 20h4L19 9l-4-4L4 16zM14 6l4 4"></path>
                            </svg>
                        </button>
                    }
                </li>
            }
        </ul>
    }
</section>

@code {
    private List<Meal> _shuffled = [];
    private bool _isShuffling;
    private string _search = string.Empty;

    private DayOfWeek Day => _mealPlanStateContainer.SelectedDate.DayOfWeek;

    /// <summary>The meal being swapped out, or null when picking a meal for an empty day.</summary>
    private Meal? CurrentMeal =>
        _mealPlanStateContainer.IsSwappingMeal ? _mealPlanStateContainer.GetMealFromSelectedDate() : null;

    /// <summary>
    /// The meals matching the search, each with its tile index: regular meals count from 0 so their tiles alternate
    /// orange and green; system meals are neutral and don't count. The meal being swapped out is left out.
    /// </summary>
    private IEnumerable<(Meal Meal, int Index)> FilteredMeals
    {
        get
        {
            var currentId = CurrentMeal?.Id;
            var regularIndex = 0;
            foreach (var meal in _shuffled.Where(m => m.Id != currentId))
            {
                var index = meal.IsRegular ? regularIndex++ : 0;
                if (string.IsNullOrWhiteSpace(_search) || meal.Name.Contains(_search, StringComparison.InvariantCultureIgnoreCase))
                {
                    yield return (meal, index);
                }
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _mealsStateContainer.CurrentSnackbar = _snackbar;
        _mealsStateContainer.OnStateChanged += StateHasChanged;
        _mealPlanStateContainer.OnStateChanged += StateHasChanged;

        await _mealsStateContainer.LoadMeals();
        Shuffle();
    }

    public void Dispose()
    {
        _mealsStateContainer.OnStateChanged -= StateHasChanged;
        _mealPlanStateContainer.OnStateChanged -= StateHasChanged;
    }

    private void Shuffle()
    {
        var systemMeals = _mealsStateContainer.Meals.Where(m => !m.IsRegular).OrderBy(m => m.Name).ToList();
        var list = _mealsStateContainer.Meals.Where(m => m.IsRegular).ToList();
        for (int i = list.Count - 1; i > 0; i--)
        {
            int j = Random.Shared.Next(i + 1);
            (list[i], list[j]) = (list[j], list[i]);
        }
        _shuffled = [.. systemMeals, .. list];
    }

    private async Task ShuffleAsync()
    {
        _isShuffling = true;
        await _mealsStateContainer.LoadMeals();
        Shuffle();
        _isShuffling = false;
    }

    private async Task AssignMeal(Meal meal)
    {
        _mealPlanStateContainer.CurrentSnackbar = _snackbar;
        if (CurrentMeal is not null)
        {
            await _mealPlanStateContainer.SwapMealOnSelectedDate(meal);
        }
        else
        {
            await _mealPlanStateContainer.AddMealToPlan(meal);
        }
    }

    private void EditMeal(Meal meal)
    {
        _mealsStateContainer.MealToEdit = meal;
        _navigationManager.NavigateTo("/meals/edit");
    }
}
