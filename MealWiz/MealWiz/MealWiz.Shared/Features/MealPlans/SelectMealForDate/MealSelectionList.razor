@inject IMealPlanStateContainer _mealPlanStateContainer
@inject ISnackbar _snackbar
@inject IStringLocalizer<MealPlansResource> L
@inject IStringLocalizer<MealsResource> M
@implements IDisposable

@* The pick-a-meal state of the Meal plan: MealPickList wired to the selected day. For a day with no meal a pick adds
   the meal; while swapping (IsSwappingMeal) it replaces the day's meal, which is left out, and Cancel goes back to the
   card. *@
<MealPickList Heading="@Heading" Hint="@Hint" ExcludedMealId="@CurrentMeal?.Id"
              ShowCancel="@(CurrentMeal is not null)" OnCancel="_mealPlanStateContainer.CancelSwap" OnPick="AssignMeal" />

@code {
    private DayOfWeek Day => _mealPlanStateContainer.SelectedDate.DayOfWeek;

    /// <summary>The meal being swapped out, or null when picking a meal for an empty day.</summary>
    private Meal? CurrentMeal =>
        _mealPlanStateContainer.IsSwappingMeal ? _mealPlanStateContainer.GetMealFromSelectedDate() : null;

    private string Heading => L[CurrentMeal is not null ? "PickMeal_SwapHeading" : "PickMeal_Heading", Day.ToWeekdayName()];

    private string Hint => CurrentMeal is { } current
        ? L["PickMeal_SwapHint", current.DisplayName(M)]
        : L["PickMeal_Hint"];

    protected override void OnInitialized() => _mealPlanStateContainer.OnStateChanged += StateHasChanged;

    public void Dispose() => _mealPlanStateContainer.OnStateChanged -= StateHasChanged;

    private async Task AssignMeal(Meal meal)
    {
        _mealPlanStateContainer.CurrentSnackbar = _snackbar;
        if (CurrentMeal is not null)
        {
            await _mealPlanStateContainer.SwapMealOnSelectedDate(meal);
        }
        else
        {
            await _mealPlanStateContainer.AddMealToPlan(meal);
        }
    }
}
