@inject IPlanWeekStateContainer _state
@inject IDrawerStateContainer _drawer

@* The global drawer's content for picking a meal for one Plan week day: the shared pick list without edit buttons and
   without the day's current meal. Picking puts the meal on the day, locks it and closes the drawer. *@
<MealPickList ExcludedMealId="@CurrentMealId" ShowEdit="false" OnPick="Pick" />

@code {
    [Parameter] public DateTime Date { get; set; }

    private int? CurrentMealId => _state.Days.FirstOrDefault(d => d.Date == Date.Date)?.Meal?.Id;

    /// <summary>Opens the drawer titled for the day.</summary>
    public static void Open(IDrawerStateContainer drawer, IStringLocalizer<MealPlansResource> localizer, DateTime date) =>
        drawer.OpenDrawer(new DrawerStateParameters
        {
            Title = localizer["PlanWeek_PickFor", date.DayOfWeek.ToWeekdayName()],
            Content = typeof(PlanWeekPickMealDrawer),
            Height = "85%",
            ContentParameters = new() { { nameof(Date), date } }
        });

    private void Pick(Meal meal)
    {
        _state.PickMeal(Date, meal);
        _drawer.CloseDrawer();
    }
}
