@inject IMealPlanStateContainer _mealPlanStateContainer
@inject ILocalStorageService _localStorage
@inject IStringLocalizer<MealPlansResource> L
@implements IDisposable

@* The week's seven day tiles. Week navigation (prev/next) is in MealPlanPage's header; swiping the strip moves a
   week too. Test hooks: week-day (+ data-date, and the selected-day / has-meal / empty-day / current-day classes),
   week-day-meal-indicator on a planned day, week-day-empty ("+") on an empty one. *@
<MudSwipeArea OnSwipeEnd="HandleSwipe" Style="width: 100%">
    <nav class="mw-week-strip" aria-label="@L["WeekStrip_Aria"]">
        @for (int i = 0; i < 7; i++)
        {
            var date = GetDateForDay(i);
            var isSelected = IsSelected(date);
            var hasMeal = _mealPlanStateContainer.DateHasMeal(date);

            <button type="button" data-testid="week-day" data-date="@date.ToString("yyyy-MM-dd")"
                    class="@GetDayContainerClass(date, isSelected, hasMeal)"
                    aria-pressed="@(isSelected ? "true" : "false")"
                    aria-label="@date.ToFullDate()"
                    @onclick="() => _mealPlanStateContainer.SelectedDate = date">
                <span class="day-name" data-testid="week-day-name">@date.ToDayTag()</span>
                <span class="day" data-testid="week-day-date">@date.Day</span>
                @if (hasMeal)
                {
                    <span class="day-dot" data-testid="week-day-meal-indicator"></span>
                }
                else
                {
                    <span class="day-plus" data-testid="week-day-empty" aria-hidden="true">+</span>
                }
            </button>
        }
    </nav>
</MudSwipeArea>

@code {
    private const string WeekStorageKey = "mealplan_selected_week";

    protected override async Task OnInitializedAsync()
    {
        _mealPlanStateContainer.OnStateChanged += StateHasChanged;

        var saved = await _localStorage.GetItemAsync<DateTime?>(WeekStorageKey);
        await _mealPlanStateContainer.NavigateToWeek(saved ?? DateTime.Now);
    }

    public void Dispose()
    {
        _mealPlanStateContainer.OnStateChanged -= StateHasChanged;
    }

    private DateTime GetDateForDay(int dayOffset) =>
        _mealPlanStateContainer.SelectedWeekStart.AddDays(dayOffset);

    private bool IsSelected(DateTime date) => date.Date == _mealPlanStateContainer.SelectedDate.Date;

    private async Task HandleSwipe(SwipeEventArgs e)
    {
        if (_mealPlanStateContainer.IsLoadingWeek) return;
        var start = _mealPlanStateContainer.SelectedWeekStart;
        if (e.SwipeDirection == SwipeDirection.LeftToRight) await _mealPlanStateContainer.NavigateToWeek(start.AddDays(-7));
        else if (e.SwipeDirection == SwipeDirection.RightToLeft) await _mealPlanStateContainer.NavigateToWeek(start.AddDays(7));
    }

    private static string GetDayContainerClass(DateTime date, bool isSelected, bool hasMeal)
    {
        string classString = "day-container";

        classString += isSelected ? " selected-day" : string.Empty;
        classString += date.Date == DateTime.Now.Date ? " current-day" : string.Empty;
        classString += hasMeal ? " has-meal" : " empty-day";

        return classString;
    }
}
