@attribute [Authorize]
@page "/meals"
@using MealWiz.Shared.Features.MealPlans.GetMealPlanByDate
@inject IMealsStateContainer _mealsStateContainer
@inject ISnackbar _snackbar
@inject ISender _mediator
@inject NavigationManager _navigationManager
@inject IStringLocalizer<MealsResource> L
@implements IDisposable

<div class="mw-page mw-meals-page">
    <ScreenHeader Label="@CountLabel" Title="@L["MealsPage_Title"]">
        <Actions>
            <AddMealMenu />
        </Actions>
    </ScreenHeader>

    <div class="mw-meals-content">
        <MudTextField T="string" data-testid="meal-list-search"
                      @bind-Value="_search"
                      Placeholder="@L["MealsPage_Search"]"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Clearable="true" />

        <div class="mw-meal-filters" role="group" aria-label="@L["MealsPage_FilterAria"]">
            <button type="button" class="mw-meal-filter" data-testid="meal-filter-all" aria-pressed="@IsPressed(MealFilter.All)" @onclick="() => _filter = MealFilter.All">@L["MealsPage_FilterAll"]</button>
            <button type="button" class="mw-meal-filter" data-testid="meal-filter-this-week" aria-pressed="@IsPressed(MealFilter.ThisWeek)" @onclick="() => _filter = MealFilter.ThisWeek">@L["MealsPage_FilterThisWeek"]</button>
            <button type="button" class="mw-meal-filter" data-testid="meal-filter-no-recipe" aria-pressed="@IsPressed(MealFilter.NoRecipe)" @onclick="() => _filter = MealFilter.NoRecipe">@L["MealsPage_FilterNoRecipe"]</button>
        </div>

        @if (!RegularMeals.Any())
        {
            <p class="mw-meals-empty" data-testid="meal-list-empty">@L["MealsPage_Empty"]</p>
        }
        else if (!FilteredMeals.Any())
        {
            <p class="mw-meals-empty" data-testid="meal-list-no-match">@NoMatchMessage</p>
        }
        else
        {
            <MealGrid Meals="FilteredMeals" PlannedDates="_plannedDates" OnMealClick="EditMeal" />
        }

        <button type="button" class="mw-meals-import" data-testid="meals-import-link" @onclick="OnImportClick">
            <span class="mw-meals-import-icon">
                <MudIcon Icon="@Icons.Material.Filled.Link" Color="Color.Inherit" Size="Size.Small" />
            </span>
            <span class="mw-meals-import-text">
                <span class="mw-meals-import-title">@L["MealsPage_ImportTitle"]</span>
                <span class="mw-meals-import-hint">@L["MealsPage_ImportHint"]</span>
            </span>
        </button>
    </div>
</div>

@code {
    private enum MealFilter { All, ThisWeek, NoRecipe }

    private string _search = string.Empty;
    private MealFilter _filter = MealFilter.All;
    private IReadOnlyDictionary<int, DateTime> _plannedDates = new Dictionary<int, DateTime>();

    // Eat Out and Leftovers can't be edited, so they're only offered when planning a day.
    private IEnumerable<Meal> RegularMeals => _mealsStateContainer.Meals.Where(m => m.IsRegular);

    // This week uses the same plan as the day tags, so a meal is in it exactly when its card shows a day.
    private IEnumerable<Meal> FilteredMeals =>
        RegularMeals
            .Where(m => _filter switch
            {
                MealFilter.ThisWeek => _plannedDates.ContainsKey(m.Id),
                MealFilter.NoRecipe => string.IsNullOrWhiteSpace(m.Recipe),
                _ => true
            })
            .Where(MatchesSearch);

    private bool MatchesSearch(Meal meal) =>
        string.IsNullOrWhiteSpace(_search)
        || ContainsSearch(meal.Name)
        || meal.Ingredients.Any(ingredient => ContainsSearch(ingredient.Name));

    private bool ContainsSearch(string? text) => text?.Contains(_search, StringComparison.InvariantCultureIgnoreCase) == true;

    private string NoMatchMessage =>
        !string.IsNullOrWhiteSpace(_search) ? L["MealsPage_NoMatchSearch", _search]
        : _filter == MealFilter.ThisWeek ? L["MealsPage_NoMatchThisWeek"]
        : L["MealsPage_NoMatchNoRecipe"];

    private string IsPressed(MealFilter filter) => filter == _filter ? "true" : "false";

    private string CountLabel => L.Plural("MealsPage_Count", RegularMeals.Count());

    protected override async Task OnInitializedAsync()
    {
        _mealsStateContainer.CurrentSnackbar = _snackbar;
        _mealsStateContainer.OnStateChanged += StateHasChanged;

        await _mealsStateContainer.LoadMeals();
        await LoadPlannedDates();
    }

    // The day tags show this calendar week, whichever week the Plan tab shows. They're a hint, so a failed load
    // leaves them out without a toast.
    private async Task LoadPlannedDates()
    {
        var result = await _mediator.Send(new GetMealPlanByDate.Query(DateTime.Now.StartOfWeek().Date));
        if (result.IsFailed || result.Value is null) return;

        _plannedDates = result.Value.MealOnDate
            .OrderBy(entry => entry.Key)
            .GroupBy(entry => entry.Value.Id)
            .ToDictionary(group => group.Key, group => group.First().Key);
    }

    public void Dispose()
    {
        _mealsStateContainer.OnStateChanged -= StateHasChanged;
    }

    private void EditMeal(Meal meal)
    {
        _mealsStateContainer.MealToEdit = meal;
        _navigationManager.NavigateTo("/meals/edit");
    }

    private void OnImportClick() => _navigationManager.NavigateTo("/meals/import");
}
