@inject IMealsStateContainer _mealsStateContainer
@inject NavigationManager _navigationManager
@inject ISnackbar _snackbar
@inject ISender _mediator
@inject IStringLocalizer<MealsResource> L
@inject IStringLocalizer<SharedResource> S

<MudLoadingButton
data-testid="save-meal-button"
@bind-Loading="IsSaving"
ButtonVariant="ButtonVariant.Button"
Variant="Variant.Filled"
Color="Color.Dark"
StartIcon="@Icons.Material.Filled.Check"
OnClick="SaveMeal">@S["Common_Save"]</MudLoadingButton>

@code {
    private bool IsSaving { get; set; }

    public async Task SaveMeal()
    {
        try
        {
            IsSaving = true;

            var result = await _mediator.Send(new SaveMeal.Command(_mealsStateContainer.MealToEdit));
            if (result.Handle(_snackbar).IsFailed) return;

            var pendingIngredients = _mealsStateContainer.MealToEdit.Ingredients
                .Where(i => i.Id == 0)
                .ToList();

            // The saved meal comes back without ingredients; keep the form's until they're saved too.
            var savedMeal = result.Value;
            savedMeal.Ingredients = _mealsStateContainer.MealToEdit.Ingredients;
            _mealsStateContainer.MealToEdit = savedMeal;

            for (var i = 0; i < pendingIngredients.Count; i++)
            {
                var ingredientResult = await _mediator.Send(new SaveIngredient.Command(pendingIngredients[i], savedMeal.Id));
                if (ingredientResult.Handle(_snackbar).IsFailed)
                {
                    // Show what was saved, with the rest still pending, so saving again doesn't duplicate any.
                    await _mealsStateContainer.ReloadIngredientsForMealToEdit();
                    foreach (var unsaved in pendingIngredients.Skip(i))
                        _mealsStateContainer.AddOrUpdatePendingIngredient(unsaved);
                    return;
                }
            }

            _snackbar.Add(L["SaveMeal_Saved"], Severity.Success);
            _navigationManager.NavigateTo("/meals");
        }
        finally
        {
            IsSaving = false;
        }
    }
}
