@page "/meals/edit"
@attribute [Authorize]
@inject IMealsStateContainer _mealsStateContainer
@inject NavigationManager _navigationManager
@inject IDrawerStateContainer _drawerStateContainer
@inject IStringLocalizer<MealsResource> L
@implements IDisposable

@* Fills the screen above the bottom nav: the visible height (dvh, with a vh fallback) minus the nav space and the
   safe areas the MAUI app draws under (status bar on top, home indicator under the nav bar). MEA-9. *@
<div class="mw-edit-meal" style="height: calc(100vh - env(safe-area-inset-top)); height: calc(100dvh - env(safe-area-inset-top));">
    <div class="mw-edit-meal-scroll">
        <section class="mw-edit-meal-header">
            <div class="mw-edit-meal-header-row">
                <button type="button" class="mw-edit-meal-back" data-testid="edit-meal-back" aria-label="@L["EditMeal_Back"]" @onclick="OnBackClick">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" />
                </button>
                <SaveMealButton />
            </div>
            <label class="mw-edit-meal-name-label" for="meal-name-input">@L["EditMeal_NameLabel"]</label>
            <input id="meal-name-input" class="mw-edit-meal-name" data-testid="meal-name-input" placeholder="@L["EditMeal_NamePlaceholder"]"
                   autocomplete="off" enterkeyhint="next"
                   @bind="_mealsStateContainer.MealToEdit.Name"
                   @onkeydown="EnterKey.Then(() => _recipeField.FocusAsync())" />
        </section>

        <div class="mw-edit-meal-body">
            <div class="mw-edit-meal-section">
                <h2 class="mw-edit-meal-heading">@L["EditMeal_Recipe"]</h2>
                <MudTextFieldExtended @ref="_recipeField" data-testid="meal-recipe-input" Lines="4" Placeholder="@L["EditMeal_RecipePlaceholder"]"
                                      @bind-Value="_mealsStateContainer.MealToEdit.Recipe" Variant="Variant.Outlined" />
            </div>

            <div class="mw-edit-meal-section">
                <div class="mw-edit-meal-heading-row">
                    <h2 class="mw-edit-meal-heading">@L["EditMeal_Ingredients"]</h2>
                    <span class="mw-edit-meal-count" data-testid="edit-meal-ingredient-count">@ItemCount</span>
                </div>

                <AddIngredientRow />

                <div class="mw-edit-meal-ingredients">
                    @foreach (Ingredient ingredient in _mealsStateContainer.MealToEdit.Ingredients)
                    {
                        <IngredientCard Ingredient="ingredient" />
                    }
                </div>
            </div>

            @if (_mealsStateContainer.IsEdit && _mealsStateContainer.MealToEdit.IsRegular)
            {
                <DeleteMealButton Meal="_mealsStateContainer.MealToEdit" />
            }
        </div>
    </div>
</div>

@code {
    private MudTextFieldExtended<string> _recipeField = default!;

    private string ItemCount => L.Plural("EditMeal_Items", _mealsStateContainer.MealToEdit.Ingredients.Count);

    protected override void OnInitialized()
    {
        _mealsStateContainer.OnStateChanged += StateHasChanged;
    }

    private void OnBackClick()
    {
        _navigationManager.NavigateTo("/meals");
    }

    public void Dispose()
    {
        _drawerStateContainer.CloseDrawer();
        _mealsStateContainer.OnStateChanged -= StateHasChanged;
    }
}
