@page "/meals/edit"
@attribute [Authorize]
@inject IMealsStateContainer _mealsStateContainer
@inject IMealImportStateContainer _mealImportStateContainer
@inject NavigationManager _navigationManager
@inject IDrawerStateContainer _drawerStateContainer
@inject IStringLocalizer<MealsResource> L
@implements IDisposable

@* Fills the screen above the bottom nav: the visible height (dvh, with a vh fallback) minus the nav space and the
   safe areas the MAUI app draws under (status bar on top, home indicator under the nav bar). MEA-9. *@
<div class="mw-edit-meal" style="height: calc(100vh - env(safe-area-inset-top)); height: calc(100dvh - env(safe-area-inset-top));">
    <div class="mw-edit-meal-scroll">
        <section class="mw-edit-meal-header">
            <div class="mw-edit-meal-header-row">
                <button type="button" class="mw-edit-meal-back" data-testid="edit-meal-back" aria-label="@L["EditMeal_Back"]" @onclick="OnBackClick">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" />
                </button>
                <SaveMealButton />
            </div>
            <label class="mw-edit-meal-name-label" for="meal-name-input">@L["EditMeal_NameLabel"]</label>
            <input id="meal-name-input" class="mw-edit-meal-name" data-testid="meal-name-input" placeholder="@L["EditMeal_NamePlaceholder"]"
                   autocomplete="off" enterkeyhint="next"
                   @bind="_mealsStateContainer.MealToEdit.Name"
                   @onkeydown="EnterKey.Then(() => _recipeField.FocusAsync())" />
        </section>

        <div class="mw-edit-meal-body">
            @if (_mealImportStateContainer.FormImport?.ParsedMeal?.IsGuessed == true)
            {
                <p class="mw-edit-meal-note" role="note" data-testid="edit-meal-guessed-note">@L["EditMeal_GuessedNote"]</p>
            }

            @if (_mealImportStateContainer.FormImport is { IsPictureImport: true })
            {
                <div class="mw-edit-meal-retry" data-testid="edit-meal-retry-section">
                    @if (_mealImportStateContainer.IsRetrying)
                    {
                        <span class="mw-edit-meal-retrying" data-testid="edit-meal-retrying">
                            <MudProgressCircular Indeterminate Color="Color.Primary" Size="Size.Small" />
                            @L["EditMeal_Retrying"]
                        </span>
                    }
                    else
                    {
                        @if (_mealImportStateContainer.RetryErrorMessage is not null)
                        {
                            <span class="mw-edit-meal-retry-error" role="alert" data-testid="edit-meal-retry-error">@_mealImportStateContainer.RetryErrorMessage</span>
                        }

                        @if (!_showHint && _mealImportStateContainer.RetryErrorMessage is null)
                        {
                            <button type="button" class="mw-edit-meal-retry-link" data-testid="edit-meal-retry" @onclick="() => _showHint = true">@L["EditMeal_Retry"]</button>
                        }
                        else
                        {
                            <MudTextField data-testid="edit-meal-hint-input" @bind-Value="_hint" Immediate
                                          Label="@L["EditMeal_HintLabel"]" Placeholder="@L["EditMeal_HintPlaceholder"]"
                                          MaxLength="@MealImportPictures.MaxHintLength" Variant="Variant.Outlined" />
                            <MudButton data-testid="edit-meal-hint-submit" Variant="Variant.Filled" Color="Color.Primary"
                                       Disabled="@string.IsNullOrWhiteSpace(_hint)" OnClick="OnRetryClick">@L["EditMeal_HintSubmit"]</MudButton>
                        }
                    }
                </div>
            }

            <div class="mw-edit-meal-section">
                <h2 class="mw-edit-meal-heading">@L["EditMeal_Recipe"]</h2>
                <MudTextFieldExtended @ref="_recipeField" data-testid="meal-recipe-input" Lines="4" Placeholder="@L["EditMeal_RecipePlaceholder"]"
                                      @bind-Value="_mealsStateContainer.MealToEdit.Recipe" Variant="Variant.Outlined" />
            </div>

            <div class="mw-edit-meal-section">
                <div class="mw-edit-meal-heading-row">
                    <h2 class="mw-edit-meal-heading">@L["EditMeal_Ingredients"]</h2>
                    <span class="mw-edit-meal-count" data-testid="edit-meal-ingredient-count">@ItemCount</span>
                </div>

                <AddIngredientRow />

                <div class="mw-edit-meal-ingredients">
                    @foreach (Ingredient ingredient in _mealsStateContainer.MealToEdit.Ingredients)
                    {
                        <IngredientCard Ingredient="ingredient" />
                    }
                </div>
            </div>

            @if (_mealsStateContainer.IsEdit && _mealsStateContainer.MealToEdit.IsRegular)
            {
                <DeleteMealButton Meal="_mealsStateContainer.MealToEdit" />
            }
        </div>
    </div>
</div>

@code {
    private MudTextFieldExtended<string> _recipeField = default!;

    private MealWiz.Shared.Features.MealImport.Models.MealImport? _formImport;
    private bool _showHint;
    private string _hint = string.Empty;

    private string ItemCount => L.Plural("EditMeal_Items", _mealsStateContainer.MealToEdit.Ingredients.Count);

    protected override void OnInitialized()
    {
        _mealsStateContainer.OnStateChanged += StateHasChanged;
        _formImport = _mealImportStateContainer.FormImport;
        _mealImportStateContainer.OnStateChanged += OnImportStateChanged;
    }

    // Realtime callbacks can arrive off the UI thread (MAUI).
    private void OnImportStateChanged() => InvokeAsync(() =>
    {
        if (!ReferenceEquals(_mealImportStateContainer.FormImport, _formImport))
        {
            _formImport = _mealImportStateContainer.FormImport;
            _showHint = false;
            _hint = string.Empty;
        }

        StateHasChanged();
    });

    // The hint stays in its field while the retry runs and after a failed one, so the user can try again. A successful
    // retry replaces the form's job, and the section starts over.
    private async Task OnRetryClick() => await _mealImportStateContainer.RetryWithHint(_hint);

    private void OnBackClick()
    {
        _navigationManager.NavigateTo("/meals");
    }

    public void Dispose()
    {
        _drawerStateContainer.CloseDrawer();
        _mealsStateContainer.OnStateChanged -= StateHasChanged;
        _mealImportStateContainer.OnStateChanged -= OnImportStateChanged;

        // Left during a retry: it finishes in the background. Otherwise the form is discarded (a save has already
        // released it), so its pictures go.
        if (_mealImportStateContainer.IsRetrying)
            _mealImportStateContainer.ContinueInBackground();
        else
            _ = _mealImportStateContainer.ReleaseFormImport();
    }
}
