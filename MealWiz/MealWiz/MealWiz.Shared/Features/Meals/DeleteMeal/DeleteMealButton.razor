@inject IDrawerStateContainer _drawerStateContainer
@inject ISender _mediator
@inject ISnackbar _snackbar
@inject NavigationManager _navigationManager
@inject IStringLocalizer<MealsResource> L

<MudLoadingButton
data-testid="delete-meal-button"
OnClick="OnDeleteClick"
ButtonVariant="ButtonVariant.Button"
Variant="Variant.Outlined"
Color="Color.Error"
StartIcon="@Icons.Material.Outlined.Delete"
FullWidth>@L["DeleteMeal_Button"]</MudLoadingButton>

@code {
    [Parameter]
    public Meal Meal { get; set; }

    private void OnDeleteClick()
    {
        _drawerStateContainer.OpenConfirmDrawer(L["DeleteMeal_ConfirmTitle"], L["DeleteMeal_ConfirmText"], OnConfirmDelete);
    }

    private async Task OnConfirmDelete()
    {
        var result = await _mediator.Send(new DeleteMeal.Command(Meal.Id));
        if (result.Handle(_snackbar).IsFailed) return;

        _drawerStateContainer.CloseDrawer();
        _snackbar.Add(L["DeleteMeal_Deleted"], Severity.Success);

        // The Meals page reloads the list when it opens.
        _navigationManager.NavigateTo("/meals");
    }
}
