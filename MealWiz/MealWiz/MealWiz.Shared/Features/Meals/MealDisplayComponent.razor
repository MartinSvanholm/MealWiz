@using MealWiz.Shared.Features.MealPlans
@inject IMealPlanStateContainer _mealPlanStateContainer
@inject IMealsStateContainer _mealsStateContainer
@inject IDrawerStateContainer _drawerStateContainer
@inject NavigationManager _navigationManager
@inject IStringLocalizer<MealPlansResource> L
@inject IStringLocalizer<MealsResource> M
@implements IDisposable

@* The selected day's meal on the Meal plan: a big orange card (name, ingredient count, recipe status), then the
   ingredients and the recipe, or a "No recipe yet" prompt. System meals (Eat Out, Leftovers) show only the card.
   Swap meal starts the Meal plan's swap mode (the page then shows the pick list). Add all to list opens GroceryList's
   merge drawer for the selected day only (MEA-74). *@
@if (Meal != null)
{
    <div class="mw-meal-display">
        <section class="mw-meal-hero" data-testid="meal-display-hero" aria-label="@L["DayCard_HeroAria", Day]">
            <svg class="mw-meal-hero-rings" width="190" height="190" viewBox="0 0 190 190" fill="none" aria-hidden="true">
                <circle cx="95" cy="95" r="90"></circle>
                <circle cx="95" cy="95" r="62"></circle>
                <circle cx="95" cy="95" r="34"></circle>
            </svg>
            <div class="mw-meal-hero-top">
                <span class="mw-meal-hero-day" data-testid="meal-display-day">@L["DayCard_DayDinner", Day]</span>
                @HeroAction
            </div>
            <h2 class="mw-meal-hero-name" data-testid="meal-display-name">@Meal.DisplayName(M)</h2>
            <p class="mw-meal-hero-summary" data-testid="meal-display-summary">@Summary</p>
            <div class="mw-meal-hero-buttons">
                <button type="button" class="mw-hero-button mw-hero-button-dark" data-testid="swap-meal-button"
                        @onclick="_mealPlanStateContainer.StartSwap">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M7 4 3 8l4 4M3 8h14M17 20l4-4-4-4M21 16H7"></path>
                    </svg>
                    @L["DayCard_Swap"]
                </button>
            </div>
        </section>

        @if (Meal.IsRegular)
        {
            <section class="mw-meal-section" data-testid="meal-display-ingredients">
                <div class="mw-meal-section-header">
                    <h3 class="mw-meal-section-title">@L["DayCard_IngredientsTitle"]</h3>
                    <button type="button" class="mw-meal-link" data-testid="add-all-to-list"
                            disabled="@(!HasGroceryIngredients)" @onclick="AddAllToList">
                        @L["DayCard_AddAllToList"]
                    </button>
                </div>
                <ul class="mw-meal-card mw-ingredient-list">
                    @if (Meal.Ingredients.Count == 0)
                    {
                        <li class="mw-ingredient mw-ingredient-empty" data-testid="meal-display-no-ingredients">@L["DayCard_NoIngredients"]</li>
                    }
                    @foreach (var ingredient in Meal.Ingredients)
                    {
                        <li class="mw-ingredient" data-testid="meal-display-ingredient">
                            <span class="mw-ingredient-bullet" aria-hidden="true"></span>
                            <span class="mw-ingredient-name" data-testid="meal-display-ingredient-name">@ingredient.Name</span>
                            <span class="mw-ingredient-amount" data-testid="meal-display-ingredient-amount">@ingredient.Amount</span>
                        </li>
                    }
                </ul>
            </section>

            @if (Meal.RecipeSteps.Count == 0)
            {
                <section class="mw-no-recipe" data-testid="meal-display-no-recipe">
                    <span class="mw-no-recipe-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 19V5a2 2 0 0 1 2-2h14v16H6a2 2 0 0 0-2 2zM8 7h8M8 11h6"></path>
                        </svg>
                    </span>
                    <div class="mw-no-recipe-text">
                        <span class="mw-no-recipe-title">@L["DayCard_NoRecipe"]</span>
                        <span class="mw-no-recipe-hint">@L["DayCard_NoRecipeHint"]</span>
                    </div>
                    <button type="button" class="mw-meal-link" data-testid="meal-display-add-recipe" @onclick="EditMeal">@L["DayCard_AddRecipe"]</button>
                </section>
            }
            else
            {
                <section class="mw-meal-section">
                    <h3 class="mw-meal-section-title">@L["DayCard_RecipeTitle"]</h3>
                    <ol class="mw-meal-card mw-recipe" data-testid="meal-display-recipe">
                        @foreach (var step in Meal.RecipeSteps)
                        {
                            <li>@step</li>
                        }
                    </ol>
                </section>
            }
        }
    </div>
}

@code {
    /// <summary>Markup in the card's top-right corner (the Meal plan puts its Remove button here).</summary>
    [Parameter]
    public RenderFragment? HeroAction { get; set; }

    public Meal? Meal { get; set; }

    private string Day => _mealPlanStateContainer.SelectedDate.DayOfWeek.ToWeekdayName();

    private string Summary
    {
        get
        {
            if (Meal is null || !Meal.IsRegular) return L["DayCard_NothingToCook"];

            var count = Meal.Ingredients.Count;
            var ingredients = L.Plural("DayCard_Ingredients", count);
            var recipe = Meal.RecipeSteps.Count == 0 ? L["DayCard_NoRecipe"] : L["DayCard_RecipeReady"];
            return L["DayCard_Summary", ingredients, recipe];
        }
    }

    protected override void OnInitialized()
    {
        Meal = _mealPlanStateContainer.GetMealFromSelectedDate();
        _mealPlanStateContainer.OnStateChanged += StateChanged;

        base.OnInitialized();
    }

    public void Dispose()
    {
        _mealPlanStateContainer.OnStateChanged -= StateChanged;
    }

    private void StateChanged()
    {
        Meal = _mealPlanStateContainer.GetMealFromSelectedDate();

        InvokeAsync(StateHasChanged);
    }

    private bool HasGroceryIngredients => Meal?.Ingredients.Any(i => i.ShowOnGroceryList) == true;

    private void AddAllToList()
    {
        if (Meal is null || !HasGroceryIngredients) return;

        // SelectedDate can carry a time of day; the drawer matches the plan's midnight keys.
        AddPlanIngredientsToGroceryListDrawer.Open(
            _drawerStateContainer, L["DayCard_AddAllTitle", Meal.Name], [_mealPlanStateContainer.SelectedDate.Date]);
    }

    private void EditMeal()
    {
        if (Meal is null) return;

        _mealsStateContainer.MealToEdit = Meal;
        _navigationManager.NavigateTo("/meals/edit");
    }
}
