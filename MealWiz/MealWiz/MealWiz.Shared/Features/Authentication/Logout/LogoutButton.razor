@inject ISender _mediator
@inject NavigationManager _navigationManager
@inject ISnackbar _snackbar
@inject IStringLocalizer<SharedResource> L

<MudButton data-testid="logout-button" OnClick="OnLogoutClick" Variant="Variant.Outlined" Color="Color.Error"
           StartIcon="@Icons.Material.Filled.Logout" FullWidth="true">
    @L["Account_Logout"]
</MudButton>

@code {
    private async Task OnLogoutClick()
    {
        var result = await _mediator.Send(new Logout.Command());

        result.Handle(_snackbar);

        if (result.IsSuccess) {
            // A full reload, so nothing of the previous user stays in memory. Dark mode and language live in storage.
            _navigationManager.NavigateTo("/login", forceLoad: true);
        }
    }
}
