@inject IStringLocalizer<AuthenticationResource> L
@inject ISender _mediator
@inject NavigationManager _navigationManager
@inject ISnackbar _snackbar

<MudButton data-testid="logout-button" OnClick="OnLogoutClick" Variant="Variant.Outlined" Color="Color.Error"
           StartIcon="@Icons.Material.Filled.Logout" FullWidth="true">
    @L["Logout_Button"]
</MudButton>

@code {
    private async Task OnLogoutClick()
    {
        var result = await _mediator.Send(new Logout.Command());

        result.Handle(_snackbar);

        if (result.IsSuccess) {
            _navigationManager.Refresh();
        }
    }
}
