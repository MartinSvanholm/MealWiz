@page "/login"
@inject ISender _mediator
@inject ISnackbar _snackbar
@inject NavigationManager _navigationManager

@* Login has no bottom nav: Layout/MainLayout.razor shows it to signed-in users only. *@
<div class="mw-login" data-testid="login-page">
    <svg class="mw-login-rings" viewBox="0 0 190 190" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="95" cy="95" r="90" /><circle cx="95" cy="95" r="62" /><circle cx="95" cy="95" r="34" />
    </svg>

    <div class="mw-login-brand">
        <span class="mw-login-logo" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Filled.Restaurant" Color="Color.Inherit" />
        </span>
        <div>
            <h1 class="mw-login-title" data-testid="login-title">MealWiz</h1>
            <p class="mw-login-tagline" data-testid="login-tagline">Plan the week. Shop once.</p>
        </div>
    </div>

    <CustomForm @ref="Form" Class="mw-login-form" @bind-IsValid="IsValid">
        <div class="mw-login-field">
            <label class="mw-login-label" for="@EmailInputId" data-testid="login-email-label">Email</label>
            <TextField data-testid="login-email" @bind-Value="Email" InputId="@EmailInputId" Placeholder="you@example.com"
                       Required InputType="InputType.Email"
                       OnKeyDown="EnterKey.Then(() => PasswordField.FocusAsync())" />
        </div>
        <div class="mw-login-field">
            <div class="mw-login-label-row">
                <label class="mw-login-label" for="@PasswordInputId" data-testid="login-password-label">Password</label>
                @* Not wired yet: MEA-69. *@
                <button type="button" class="mw-login-link" data-testid="login-forgot-password">Forgot password?</button>
            </div>
            <TextField @ref="PasswordField" data-testid="login-password" @bind-Value="Password" InputId="@PasswordInputId"
                       Placeholder="Your password" Required InputType="InputType.Password"
                       OnKeyDown="EnterKey.Then(Login)" />
        </div>
        <Button data-testid="login-submit" OnClick="Login" Class="mw-login-submit" FullWidth="@true" IsLoading="IsLoading">Log in</Button>
        <p class="mw-login-signup">
            No account yet?
            @* Not wired yet: MEA-70. *@
            <button type="button" class="mw-login-link" data-testid="login-create-account">Create one</button>
        </p>
    </CustomForm>
</div>

@code {
    private string Email { get; set; } = default!;
    private string Password { get; set; } = default!;
    private bool IsValid { get; set; }
    private CustomForm Form { get; set; } = default!;
    private TextField PasswordField { get; set; } = default!;
    private bool IsLoading { get; set; }

    private const string EmailInputId = "login-email-input";
    private const string PasswordInputId = "login-password-input";

    private async Task Login()
    {
        IsLoading = true;

        try
        {
            await Form.Validate();
            if (!IsValid) return;

            var result = await _mediator.Send(new Login.Command(Email, Password));
            result.Handle(_snackbar);

            if (result.IsSuccess)
                _navigationManager.NavigateTo("/");
        }
        finally
        {
            IsLoading = false;
        }
    }
}