@page "/login"
@inject IStringLocalizer<AuthenticationResource> L
@inject ISender _mediator
@inject ISnackbar _snackbar
@inject NavigationManager _navigationManager

@* Login has no bottom nav: Layout/MainLayout.razor shows it to signed-in users only. *@
<AuthShell TestIdPrefix="login">
    <CustomForm @ref="Form" Class="mw-auth-form" @bind-IsValid="IsValid">
        <div class="mw-auth-field">
            <label class="mw-auth-label" for="@EmailInputId" data-testid="login-email-label">@L["Auth_Email"]</label>
            <TextField data-testid="login-email" @bind-Value="Email" InputId="@EmailInputId" Placeholder="@L["Auth_EmailPlaceholder"].Value"
                       Required InputType="InputType.Email"
                       OnKeyDown="EnterKey.Then(() => PasswordField.FocusAsync())" />
        </div>
        <div class="mw-auth-field">
            <div class="mw-auth-label-row">
                <label class="mw-auth-label" for="@PasswordInputId" data-testid="login-password-label">@L["Auth_Password"]</label>
                <a class="mw-auth-link" href="forgot-password" data-testid="login-forgot-password">@L["Login_ForgotPassword"]</a>
            </div>
            <TextField @ref="PasswordField" data-testid="login-password" @bind-Value="Password" InputId="@PasswordInputId"
                       Placeholder="@L["Login_PasswordPlaceholder"].Value" Required InputType="InputType.Password"
                       OnKeyDown="EnterKey.Then(Login)" />
        </div>
        <Button data-testid="login-submit" OnClick="Login" Class="mw-auth-submit" FullWidth="@true" IsLoading="IsLoading">@L["Auth_LogIn"]</Button>
        <p class="mw-auth-switch">
            @L["Login_NoAccount"]
            <a class="mw-auth-link" href="signup" data-testid="login-create-account">@L["Login_CreateOne"]</a>
        </p>
    </CustomForm>
</AuthShell>

@code {
    private string Email { get; set; } = default!;
    private string Password { get; set; } = default!;
    private bool IsValid { get; set; }
    private CustomForm Form { get; set; } = default!;
    private TextField PasswordField { get; set; } = default!;
    private bool IsLoading { get; set; }

    private const string EmailInputId = "login-email-input";
    private const string PasswordInputId = "login-password-input";

    private async Task Login()
    {
        IsLoading = true;

        try
        {
            await Form.Validate();
            if (!IsValid) return;

            var result = await _mediator.Send(new Login.Command(Email, Password));
            result.Handle(_snackbar);

            if (result.IsSuccess)
                _navigationManager.NavigateTo("/");
        }
        finally
        {
            IsLoading = false;
        }
    }
}