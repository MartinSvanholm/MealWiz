@page "/reset-password"
@inject ISender _mediator
@inject ISnackbar _snackbar
@inject NavigationManager _navigationManager

@* Reached from the reset email's link, signed out. The user is signed in only once the new password is set, so
   there's no bottom nav here either. *@
<AuthShell TestIdPrefix="reset">
    @if (LinkError is not null)
    {
        <div class="mw-auth-form">
            <p class="mw-auth-note" data-testid="reset-expired">@LinkError</p>
            <p class="mw-auth-switch">
                <a class="mw-auth-link" href="forgot-password" data-testid="reset-request-again">Send a new link</a>
            </p>
        </div>
    }
    else
    {
        <CustomForm @ref="Form" Class="mw-auth-form" @bind-IsValid="IsValid">
            <div class="mw-auth-field">
                <label class="mw-auth-label" for="@PasswordInputId" data-testid="reset-password-label">New password</label>
                <TextField data-testid="reset-password" @bind-Value="Password" InputId="@PasswordInputId"
                           Placeholder="Choose a new password" Required InputType="InputType.Password"
                           OnKeyDown="EnterKey.Then(() => PasswordRepeatField.FocusAsync())" />
            </div>
            <div class="mw-auth-field">
                <label class="mw-auth-label" for="@PasswordRepeatInputId" data-testid="reset-password-repeat-label">Repeat password</label>
                <TextField @ref="PasswordRepeatField" data-testid="reset-password-repeat" @bind-Value="PasswordRepeat"
                           InputId="@PasswordRepeatInputId" Placeholder="The same password again" Required
                           InputType="InputType.Password" OnKeyDown="EnterKey.Then(SetPassword)" />
            </div>
            <Button data-testid="reset-submit" OnClick="SetPassword" Class="mw-auth-submit" FullWidth="@true" IsLoading="IsLoading">Set password</Button>
        </CustomForm>
    }
</AuthShell>

@code {
    private string Password { get; set; } = default!;
    private string PasswordRepeat { get; set; } = default!;
    private bool IsValid { get; set; }
    private CustomForm Form { get; set; } = default!;
    private TextField PasswordRepeatField { get; set; } = default!;
    private bool IsLoading { get; set; }

    /// <summary>The URL the email's link landed on, with the recovery session in its fragment.</summary>
    private Uri EmailLink { get; set; } = default!;

    /// <summary>Set when the link has expired, was used already, or the page was opened without one.</summary>
    private string? LinkError { get; set; }

    private const string PasswordInputId = "reset-password-input";
    private const string PasswordRepeatInputId = "reset-password-repeat-input";

    protected override void OnInitialized()
    {
        EmailLink = new Uri(_navigationManager.Uri);
        LinkError = ResetLink.Read(EmailLink).Error;

        // Keep the tokens out of the address bar and the history.
        if (EmailLink.Fragment.Length > 0)
            _navigationManager.NavigateTo("reset-password", replace: true);
    }

    private async Task SetPassword()
    {
        IsLoading = true;

        try
        {
            await Form.Validate();
            if (!IsValid) return;

            if (Password != PasswordRepeat)
            {
                _snackbar.Add("Passwords don't match", Severity.Error);
                return;
            }

            var result = await _mediator.Send(new ResetPassword.Command(EmailLink, Password));
            result.Handle(_snackbar);

            if (result.IsSuccess)
                _navigationManager.NavigateTo("/");
        }
        finally
        {
            IsLoading = false;
        }
    }
}
