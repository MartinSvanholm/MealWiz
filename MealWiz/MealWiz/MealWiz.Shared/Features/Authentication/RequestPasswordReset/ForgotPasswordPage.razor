@page "/forgot-password"
@inject ISender _mediator
@inject ISnackbar _snackbar
@inject NavigationManager _navigationManager

@* Like Login, no bottom nav: Layout/MainLayout.razor shows it to signed-in users only. *@
<AuthShell TestIdPrefix="forgot">
    @if (SentTo is not null)
    {
        <div class="mw-auth-form">
            <p class="mw-auth-note" data-testid="forgot-check-email">
                Check your email: if there's an account for @SentTo, we've sent it a link to choose a new password.
            </p>
            <p class="mw-auth-switch">
                <a class="mw-auth-link" href="login" data-testid="forgot-login">Back to log in</a>
            </p>
        </div>
    }
    else
    {
        <CustomForm @ref="Form" Class="mw-auth-form" @bind-IsValid="IsValid">
            <p class="mw-auth-note">Enter your account's email and we'll send you a link to choose a new password.</p>
            <div class="mw-auth-field">
                <label class="mw-auth-label" for="@EmailInputId" data-testid="forgot-email-label">Email</label>
                <TextField data-testid="forgot-email" @bind-Value="Email" InputId="@EmailInputId" Placeholder="you@example.com"
                           Required InputType="InputType.Email" OnKeyDown="EnterKey.Then(Send)" />
            </div>
            <Button data-testid="forgot-submit" OnClick="Send" Class="mw-auth-submit" FullWidth="@true" IsLoading="IsLoading">Send reset link</Button>
            <p class="mw-auth-switch">
                Remembered it?
                <a class="mw-auth-link" href="login" data-testid="forgot-login">Log in</a>
            </p>
        </CustomForm>
    }
</AuthShell>

@code {
    private string Email { get; set; } = default!;
    private bool IsValid { get; set; }
    private CustomForm Form { get; set; } = default!;
    private bool IsLoading { get; set; }

    /// <summary>Set once the reset link has been asked for.</summary>
    private string? SentTo { get; set; }

    private const string EmailInputId = "forgot-email-input";

    private async Task Send()
    {
        IsLoading = true;

        try
        {
            await Form.Validate();
            if (!IsValid) return;

            var result = await _mediator.Send(new RequestPasswordReset.Command(Email, _navigationManager.ToAbsoluteUri("reset-password").ToString()));
            result.Handle(_snackbar);

            if (result.IsSuccess)
                SentTo = Email;
        }
        finally
        {
            IsLoading = false;
        }
    }
}
