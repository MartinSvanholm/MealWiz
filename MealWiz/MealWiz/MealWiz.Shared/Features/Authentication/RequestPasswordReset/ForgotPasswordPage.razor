@page "/forgot-password"
@inject IStringLocalizer<AuthenticationResource> L
@inject ISender _mediator
@inject ISnackbar _snackbar
@inject MealWiz.Shared.Features.Authentication.EmailLinks.EmailLinkBuilder _links

@* Like Login, no bottom nav: Layout/MainLayout.razor shows it to signed-in users only. *@
<AuthShell TestIdPrefix="forgot">
    @if (SentTo is not null)
    {
        <div class="mw-auth-form">
            <p class="mw-auth-note" data-testid="forgot-check-email">
                @L["Forgot_CheckEmail", SentTo]
            </p>
            @if (_links.OpensInBrowser)
            {
                <p class="mw-auth-note" data-testid="forgot-opens-in-browser">@L["Forgot_OpensInBrowser"]</p>
            }
            <p class="mw-auth-switch">
                <a class="mw-auth-link" href="login" data-testid="forgot-login">@L["Forgot_BackToLogIn"]</a>
            </p>
        </div>
    }
    else
    {
        <CustomForm @ref="Form" Class="mw-auth-form" @bind-IsValid="IsValid">
            <p class="mw-auth-note">@L["Forgot_Intro"]</p>
            <div class="mw-auth-field">
                <label class="mw-auth-label" for="@EmailInputId" data-testid="forgot-email-label">@L["Auth_Email"]</label>
                <TextField data-testid="forgot-email" @bind-Value="Email" InputId="@EmailInputId" Placeholder="@L["Auth_EmailPlaceholder"].Value"
                           Required InputType="InputType.Email" OnKeyDown="EnterKey.Then(Send)" />
            </div>
            <Button data-testid="forgot-submit" OnClick="Send" Class="mw-auth-submit" FullWidth="@true" IsLoading="IsLoading">@L["Forgot_Submit"]</Button>
            <p class="mw-auth-switch">
                @L["Forgot_Remembered"]
                <a class="mw-auth-link" href="login" data-testid="forgot-login">@L["Auth_LogIn"]</a>
            </p>
        </CustomForm>
    }
</AuthShell>

@code {
    private string Email { get; set; } = default!;
    private bool IsValid { get; set; }
    private CustomForm Form { get; set; } = default!;
    private bool IsLoading { get; set; }

    /// <summary>Set once the reset link has been asked for.</summary>
    private string? SentTo { get; set; }

    private const string EmailInputId = "forgot-email-input";

    private async Task Send()
    {
        IsLoading = true;

        try
        {
            await Form.Validate();
            if (!IsValid) return;

            var result = await _mediator.Send(new RequestPasswordReset.Command(Email, _links.Build("reset-password")));
            result.Handle(_snackbar);

            if (result.IsSuccess)
                SentTo = Email;
        }
        finally
        {
            IsLoading = false;
        }
    }
}
