@* The ingredient drawer's content: name and amount side by side, the "Add to grocery list" switch row, and the Save
   button in the footer. The drawer header's delete action comes from IngredientCard (HeaderAction). *@
<div class="mw-ingredient-drawer">
    <div class="mw-ingredient-drawer-fields">
        <div class="mw-field">
            <label class="mw-field-label" for="ingredient-name">Name</label>
            <MudTextField data-testid="ingredient-name-input" InputId="ingredient-name" @bind-Value="Ingredient.Name" Variant="Variant.Outlined"
                          OnKeyDown="EnterKey.Then(() => _amountField.FocusAsync())" />
        </div>
        <div class="mw-field">
            <label class="mw-field-label" for="ingredient-amount">Amount</label>
            <MudTextField @ref="_amountField" data-testid="ingredient-amount-input" InputId="ingredient-amount" @bind-Value="Ingredient.Amount" Variant="Variant.Outlined"
                          Immediate OnKeyDown="EnterKey.Then(() => _saveButton.SaveAsync())" />
        </div>
    </div>
    <div class="mw-ingredient-drawer-switch">
        <span class="mw-ingredient-drawer-switch-icon">
            <MudIcon Icon="@Icons.Material.Outlined.ShoppingCart" Color="Color.Inherit" Size="Size.Small" />
        </span>
        <MudSwitch T="bool" data-testid="ingredient-show-on-grocery-list-switch" @bind-Value="Ingredient.ShowOnGroceryList"
                   Label="Add to grocery list" LabelPlacement="Placement.Start" Color="Color.Primary" />
    </div>
    <DrawerFooter>
        <SaveIngredientButton @ref="_saveButton" Ingredient="Ingredient" />
    </DrawerFooter>
</div>

@code {
    [Parameter]
    public Ingredient Ingredient { get; set; }

    private MudTextField<string> _amountField = default!;
    private SaveIngredientButton _saveButton = default!;
}
