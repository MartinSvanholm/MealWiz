@inject IDrawerStateContainer _drawerStateContainer
@inject IStringLocalizer<IngredientsResource> L

@* The add-ingredient row above the ingredient list: name, amount and an orange add button. The button (or Enter in the
   amount) opens the ingredient drawer, filled in with whatever was typed here and empty otherwise; the ingredient is
   saved only from the drawer. Enter moves from the name to the amount. New ingredients go on the grocery list; the
   drawer's switch changes that. *@
<div class="mw-add-ingredient">
    <div class="mw-add-ingredient-name">
        <MudTextField T="string" @ref="_nameField" data-testid="add-ingredient-name" Placeholder="@L["AddIngredient_Name"]" aria-label="@L["AddIngredient_Name"]"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate @bind-Value="_name"
                      OnKeyDown="EnterKey.Then(() => _amountField.FocusAsync())" />
    </div>
    <div class="mw-add-ingredient-amount">
        <MudTextField T="string" @ref="_amountField" data-testid="add-ingredient-amount" Placeholder="@L["AddIngredient_Amount"]" aria-label="@L["AddIngredient_Amount"]"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate @bind-Value="_amount"
                      OnKeyDown="EnterKey.Then(OpenDrawer)" />
    </div>
    <button type="button" class="mw-add-ingredient-button" data-testid="create-ingredient-button" aria-label="@L["AddIngredient_Add"]"
            @onclick="OpenDrawer">
        <MudIcon Icon="@Icons.Material.Filled.Add" Color="Color.Inherit" />
    </button>
</div>

@code {
    private string _name = string.Empty;
    private string _amount = string.Empty;
    private MudTextField<string> _nameField = default!;
    private MudTextField<string> _amountField = default!;

    /// <summary>
    /// Opens the drawer for a new ingredient with what was typed here, and clears the row: from here on the drawer
    /// holds the values, and its Save button adds the ingredient.
    /// </summary>
    private Task OpenDrawer()
    {
        var ingredient = new Ingredient
        {
            Name = _name?.Trim() ?? string.Empty,
            Amount = _amount?.Trim() ?? string.Empty,
            ShowOnGroceryList = true
        };

        _name = string.Empty;
        _amount = string.Empty;

        _drawerStateContainer.OpenDrawer(new DrawerStateParameters
        {
            Content = typeof(IngredientDrawer),
            Title = L["AddIngredient_Add"],
            Height = "45%",
            ContentParameters = new Dictionary<string, object>
            {
                { nameof(IngredientDrawer.Ingredient), ingredient }
            }
        });
        return Task.CompletedTask;
    }
}
