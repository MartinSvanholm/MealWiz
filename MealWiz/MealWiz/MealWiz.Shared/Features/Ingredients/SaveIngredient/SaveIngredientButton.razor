@inject ISnackbar _snackbar
@inject IDrawerStateContainer _drawerStateContainer
@inject IMealsStateContainer _mealsStateContainer

<MudLoadingButton data-testid="save-ingredient-button" OnClick="SaveAsync" @bind-Loading="IsLoading" Variant="Variant.Filled" Color="Color.Primary" ButtonVariant="ButtonVariant.Button" FullWidth>Save ingredient</MudLoadingButton>

@code {
    [Parameter]
    public Ingredient Ingredient { get; set; }

    private bool IsLoading { get; set; }

    public async Task SaveAsync()
    {
        // An ingredient needs a name (the add row used to check this before the drawer took over saving).
        if (string.IsNullOrWhiteSpace(Ingredient.Name))
        {
            _snackbar.Add("Give the ingredient a name.", Severity.Warning);
            return;
        }

        Ingredient.Name = Ingredient.Name.Trim();
        IsLoading = true;

        try
        {
            var wasSaved = _mealsStateContainer.IsEdit;
            var result = await _mealsStateContainer.SaveIngredientForMealToEdit(Ingredient);
            if (result.Handle(_snackbar).IsFailed) return;

            _drawerStateContainer.CloseDrawer();
            if (wasSaved) _snackbar.Add("Ingredient saved.", Severity.Success);
        }
        finally
        {
            IsLoading = false;
        }
    }
}
