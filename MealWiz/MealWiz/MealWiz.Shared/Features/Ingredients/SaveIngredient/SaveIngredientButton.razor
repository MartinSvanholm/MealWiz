@inject ISnackbar _snackbar
@inject IDrawerStateContainer _drawerStateContainer
@inject IMealsStateContainer _mealsStateContainer
@inject IStringLocalizer<IngredientsResource> L

<MudLoadingButton data-testid="save-ingredient-button" OnClick="SaveAsync" @bind-Loading="IsLoading" Variant="Variant.Filled" Color="Color.Primary" ButtonVariant="ButtonVariant.Button" FullWidth>@L["SaveIngredient_Button"]</MudLoadingButton>

@code {
    [Parameter]
    public Ingredient Ingredient { get; set; }

    /// <summary>
    /// The drawer's edited copy of <see cref="Ingredient"/>. Its fields are applied to the ingredient for the save and
    /// undone if the save fails (MEA-77). Without it, the ingredient is saved as it is.
    /// </summary>
    [Parameter]
    public Ingredient? Changes { get; set; }

    private bool IsLoading { get; set; }

    public async Task SaveAsync()
    {
        var edited = Changes ?? Ingredient;

        // An ingredient needs a name (the add row used to check this before the drawer took over saving).
        if (string.IsNullOrWhiteSpace(edited.Name))
        {
            _snackbar.Add(L["SaveIngredient_NameRequired"], Severity.Warning);
            return;
        }

        var before = Ingredient.Clone();
        Ingredient.CopyEditableFieldsFrom(edited);
        Ingredient.Name = Ingredient.Name.Trim();
        IsLoading = true;
        var isSaved = false;

        try
        {
            var wasSaved = _mealsStateContainer.IsEdit;
            var result = await _mealsStateContainer.SaveIngredientForMealToEdit(Ingredient);
            if (result.Handle(_snackbar).IsFailed) return;

            isSaved = true;
            _drawerStateContainer.CloseDrawer();
            if (wasSaved) _snackbar.Add(L["Ingredient_Saved"], Severity.Success);
        }
        finally
        {
            if (!isSaved) Ingredient.CopyEditableFieldsFrom(before);
            IsLoading = false;
        }
    }
}
