@inject ISender _mediator
@inject ISnackbar _snackbar
@inject IDrawerStateContainer _drawerStateContainer
@inject IMealsStateContainer _mealsStateContainer

<MudLoadingButton data-testid="save-ingredient-button" OnClick="SaveIngredient" @bind-Loading="IsLoading" Variant="Variant.Filled" Color="Color.Success" ButtonVariant="ButtonVariant.Button">Save</MudLoadingButton>

@code {
    [Parameter]
    public Ingredient Ingredient { get; set; }

    private bool IsLoading { get; set; }

    private async Task SaveIngredient()
    {
        IsLoading = true;

        try
        {
            if (!_mealsStateContainer.IsEdit)
            {
                _mealsStateContainer.AddOrUpdatePendingIngredient(Ingredient);
                _drawerStateContainer.CloseDrawer();
            }
            else
            {
                var result = await _mediator.Send(new SaveIngredient.Command(Ingredient, _mealsStateContainer.MealToEdit.Id));
                if (result.Handle(_snackbar).IsFailed) return;

                await _mealsStateContainer.ReloadIngredientsForMealToEdit();
                _drawerStateContainer.CloseDrawer();
                _snackbar.Add("Ingredient saved.", Severity.Success);
            }
        }
        finally
        {
            IsLoading = false;
        }
    }
}
