@inject IDrawerStateContainer _drawerStateContainer

@* One ingredient row on the edit meal form: name, amount chip and trash.
   Tapping the row or the chip opens the ingredient drawer. *@
<div class="mw-ingredient-row" data-testid="ingredient-card" @onclick="EditIngredient">
    <span class="mw-ingredient-name">@Ingredient.Name</span>
    <button type="button" class="mw-ingredient-amount" data-testid="ingredient-amount-chip" data-empty="@(HasAmount ? "false" : "true")"
            @onclick="EditIngredient" @onclick:stopPropagation="true">
        <span class="mw-ingredient-amount-text">@(HasAmount ? Ingredient.Amount : "+ amount")</span>
    </button>
    <span class="mw-ingredient-delete" @onclick:stopPropagation="true">
        <DeleteIngredientButton Ingredient="Ingredient" />
    </span>
</div>

@code {
    [Parameter]
    public Ingredient Ingredient { get; set; }

    private bool HasAmount => !string.IsNullOrWhiteSpace(Ingredient.Amount);

    public void EditIngredient()
    {
        _drawerStateContainer.OpenDrawer(new DrawerStateParameters
        {
            Content = typeof(IngredientDrawer),
            Title = "Edit ingredient",
            Height = "45%",
            HeaderAction = @<DeleteIngredientButton Ingredient="Ingredient" TestId="drawer-delete-ingredient" />,
            ContentParameters = new Dictionary<string, object>
            {
                { nameof(IngredientDrawer.Ingredient), Ingredient }
            }
        });
    }
}
