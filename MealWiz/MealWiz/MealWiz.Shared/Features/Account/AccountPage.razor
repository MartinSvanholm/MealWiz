@attribute [Authorize]
@page "/account"
@using System.Security.Claims
@using MealWiz.Shared.Features.Account.ChangePassword
@using MealWiz.Shared.Features.Account.ChangeEmail
@using MealWiz.Shared.Theme
@using Microsoft.AspNetCore.Components.Authorization
@inject IThemeService ThemeService
@implements IDisposable

<div class="mw-page mw-account" data-testid="account-page">
    <SubPageHeader Label="Profile" Title="Account" BackHref="/" BackTestId="account-back" />

    <div class="mw-account-body">
        <section class="mw-account-profile" data-testid="account-profile">
            <span class="mw-account-avatar" data-testid="account-avatar" aria-hidden="true">
                @if (string.IsNullOrEmpty(Initial))
                {
                    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Inherit" />
                }
                else
                {
                    @Initial
                }
            </span>
            <div class="mw-account-profile-text">
                <span class="mw-account-profile-caption">Signed in as</span>
                <span class="mw-account-email" data-testid="account-email">@Email</span>
            </div>
        </section>

        <section class="mw-account-section">
            <h2 class="mw-account-section-title">Settings</h2>
            <div class="mw-account-group">
                <div class="mw-account-row">
                    <span class="mw-account-row-icon" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Outlined.DarkMode" Color="Color.Inherit" />
                    </span>
                    <span class="mw-account-row-label">Dark mode</span>
                    <MudSwitch T="bool" data-testid="dark-mode-switch"
                               Value="ThemeService.IsDarkMode"
                               ValueChanged="OnToggleDarkMode"
                               Color="Color.Primary"
                               aria-label="Dark mode" />
                </div>
            </div>
        </section>

        <ChangePasswordForm />

        <ChangeEmailForm />

        <div class="mw-account-logout">
            <LogoutButton />
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>The signed-in address: Supabase's access token carries it in the "email" claim.</summary>
    private string? Email { get; set; }

    private string? Initial => string.IsNullOrEmpty(Email) ? null : char.ToUpperInvariant(Email[0]).ToString();

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationState is null) return;

        var user = (await AuthenticationState).User;
        Email = user.FindFirst("email")?.Value ?? user.FindFirst(ClaimTypes.Email)?.Value ?? user.Identity?.Name;
    }

    // The theme is read from local storage after the first render, so on a direct load of /account the switch has to
    // follow ThemeService.OnChange (MEA-71).
    protected override void OnInitialized() => ThemeService.OnChange += OnThemeChanged;

    public void Dispose() => ThemeService.OnChange -= OnThemeChanged;

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private async Task OnToggleDarkMode(bool _) => await ThemeService.ToggleAsync();
}
