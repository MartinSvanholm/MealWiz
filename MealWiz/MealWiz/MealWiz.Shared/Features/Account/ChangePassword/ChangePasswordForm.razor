@using MealWiz.Shared.Features.Account.ChangePassword
@inject ISender _mediator
@inject ISnackbar _snackbar
@inject IStringLocalizer<AccountResource> L

<section class="mw-account-section" data-testid="change-password-section">
    <h2 class="mw-account-section-title">@L["ChangePassword_Title"]</h2>
    <CustomForm @ref="Form" Class="mw-auth-form" @bind-IsValid="IsValid">
        <div class="mw-auth-field">
            <label class="mw-auth-label" for="@NewInputId">@L["ChangePassword_New"]</label>
            <TextField data-testid="change-password-new" @bind-Value="Password" InputId="@NewInputId"
                       Placeholder="@L["ChangePassword_NewPlaceholder"].Value" Required InputType="InputType.Password"
                       OnKeyDown="EnterKey.Then(() => RepeatField.FocusAsync())" />
        </div>
        <div class="mw-auth-field">
            <label class="mw-auth-label" for="@RepeatInputId">@L["ChangePassword_Repeat"]</label>
            <TextField @ref="RepeatField" data-testid="change-password-repeat" @bind-Value="PasswordRepeat"
                       InputId="@RepeatInputId" Placeholder="@L["ChangePassword_RepeatPlaceholder"].Value" Required
                       InputType="InputType.Password" OnKeyDown="EnterKey.Then(Change)" />
        </div>
        <Button data-testid="change-password-submit" OnClick="Change" Class="mw-auth-submit" FullWidth="@true" IsLoading="IsLoading">@L["ChangePassword_Submit"]</Button>
    </CustomForm>
</section>

@code {
    private string? Password { get; set; }
    private string? PasswordRepeat { get; set; }
    private bool IsValid { get; set; }
    private CustomForm Form { get; set; } = default!;
    private TextField RepeatField { get; set; } = default!;
    private bool IsLoading { get; set; }

    private const string NewInputId = "change-password-new-input";
    private const string RepeatInputId = "change-password-repeat-input";

    private async Task Change()
    {
        IsLoading = true;

        try
        {
            await Form.Validate();
            if (!IsValid) return;

            if (Password != PasswordRepeat)
            {
                _snackbar.Add(L["ChangePassword_Mismatch"], Severity.Error);
                return;
            }

            var result = await _mediator.Send(new ChangePassword.Command(Password!));
            result.Handle(_snackbar);

            if (result.IsSuccess)
            {
                Password = null;
                PasswordRepeat = null;
            }
        }
        finally
        {
            IsLoading = false;
        }
    }
}
