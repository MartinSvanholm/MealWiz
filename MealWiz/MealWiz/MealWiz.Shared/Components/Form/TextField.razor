<MudTextField 
Value="@Value" 
ValueChanged="@ValueChanged"
Label="@Label" 
Variant="@Variant"
Required="@Required"
Class="@Class"
Immediate="@Immediate"
InputMode="@InputMode"
InputType="@InputType"
OnKeyDown="@OnKeyDown"
@ref="_field"
@attributes="UserAttributes"/>

@code {
    private MudTextField<string> _field = default!;

    public ValueTask FocusAsync() => _field.FocusAsync();

    /// <summary>For Enter to move to the next field, see <see cref="EnterKey"/>.</summary>
    [Parameter]
    public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    [Parameter]
    public string Value { get; set; } = default!;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = default!;

    [Parameter]
    public Variant Variant { get; set; } = Variant.Outlined;

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public string Class { get; set; } = default!;

    [Parameter]
    public bool Immediate { get; set; } = true;
    
    [Parameter]
    public InputMode InputMode { get; set; } = InputMode.text;

    [Parameter]
    public InputType InputType { get; set; } = InputType.Text;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? UserAttributes { get; set; }
}