@inject NavigationManager navigationManager
@implements IDisposable

@* The three tabs inside the floating bottom nav (the bar itself is in Layout/MainLayout.razor). The Meals tab stays
   active on its sub-pages (Edit meal, Import meal). *@
<div class="mw-nav-tabs">
    <CustomNavLink data-testid="nav-meal-plan" IsActive="@(location == "" || location == "plan-week")" Href="/" Icon="@Icons.Material.Filled.CalendarMonth">Plan</CustomNavLink>

    <CustomNavLink data-testid="nav-grocery-list" IsActive="@(location == "grocerylist")" Href="/grocerylist" Icon="@Icons.Material.Outlined.ShoppingCart">Groceries</CustomNavLink>

    <CustomNavLink data-testid="nav-meals" IsActive="@(location == "meals" || location.StartsWith("meals/"))" Href="/meals" Icon="@Icons.Material.Filled.Restaurant">Meals</CustomNavLink>
</div>

@code {
    private string location { get => navigationManager.Uri.Split(navigationManager.BaseUri)[1].Split("?")[0]; }

    protected override void OnInitialized()
    {
        navigationManager.LocationChanged += LocationChanged;

        base.OnInitialized();
    }

    public void Dispose()
    {
        navigationManager.LocationChanged -= LocationChanged;
    }

    private void LocationChanged(object sender, EventArgs e) {
        StateHasChanged();
    }
}
