@inject NavigationManager navigationManager
@implements IDisposable

<MudStack Row Justify="Justify.SpaceAround" Style="width: 100%" AlignItems="AlignItems.Center" Spacing="0">
    <CustomNavLink data-testid="nav-meal-plan" IsActive="@(location == "" ? true : false)" Href="/" Icon="@Icons.Material.Filled.FoodBank">Meal plan</CustomNavLink>

    <CustomNavLink data-testid="nav-grocery-list" IsActive="@(location == "grocerylist" ? true : false)" Href="/grocerylist" Icon="@Icons.Material.Outlined.ShoppingCart">Grocery list</CustomNavLink>

    <CustomNavLink data-testid="nav-meals" IsActive="@(location == "meals" ? true : false)" Href="/meals" Icon="@Icons.Material.Filled.Restaurant">Meals</CustomNavLink>
</MudStack>

@code {
    private MudTheme Theme = new MudTheme();
    private string location { get => navigationManager.Uri.Split(navigationManager.BaseUri)[1].Split("?")[0]; }

    protected override void OnInitialized()
    {
        navigationManager.LocationChanged += LocationChanged;

        base.OnInitialized();
    }

    public void Dispose()
    {
        navigationManager.LocationChanged -= LocationChanged;
    }

    private void LocationChanged(object sender, EventArgs e) {
        StateHasChanged();
    }
}