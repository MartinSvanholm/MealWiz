@using MealWiz.Shared.Localization
@using Microsoft.Extensions.Localization
@using MealWiz.Shared.Services.Authentication
@inject IStringLocalizer<SharedResource> L
<SessionGate>
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="new[] { typeof(MealWiz.Shared._Imports).Assembly}">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MealWiz.Shared.Layout.MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                <Authorizing>
                    @L["Route_Authorizing"]
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>@L["Route_NotFoundTitle"]</PageTitle>
            <LayoutView Layout="@typeof(MealWiz.Shared.Layout.MainLayout)">
                <p role="alert">@L["Route_NotFoundMessage"]</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
</SessionGate>