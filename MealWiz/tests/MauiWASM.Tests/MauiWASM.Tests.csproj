<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runs on Microsoft.Testing.Platform (opted in via the repo-root global.json), so no VSTest adapter packages. -->
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <!-- Code coverage (Cobertura) for the test run. CI collects it through the verify script's coverage option. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="bunit" Version="2.13.3" />
    <!-- E2ETests drive Chromium only. The fixture installs it on first run (TestInfrastructure/E2E/E2EEnvironment). -->
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel, for the static host that serves the published app to the E2E tests. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MauiWASM\MauiWASM.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real config files the web app ships, read by AppSettingsTests. -->
    <None Include="..\..\MauiWASM\wwwroot\appsettings.*.json" LinkBase="appsettings" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
