{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "Supabase:Url": "http://127.0.0.1:54321",
    "Supabase:ServiceRoleKey": "<service_role key from `supabase status`>",
    "Anthropic:ApiKey": "<API key from the MealWiz workspace in the Claude Console>",
    "Anthropic:Model": "claude-haiku-5-5",
    "MealPictureImport:DailyLimit": "20"
  },
  "Host": {
    "CORS": "http://localhost:5053,https://localhost:7033"
  }
}
